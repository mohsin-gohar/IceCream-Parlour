@model IEnumerable<Ice_Cream_Parlour_Eproject.Models.GalleryItemViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Gallery";
    var items = Model?.ToList() ?? new List<Ice_Cream_Parlour_Eproject.Models.GalleryItemViewModel>();
    var types = items.Select(i => i.Type).Where(t => !string.IsNullOrWhiteSpace(t)).Distinct().OrderBy(t => t).ToList();
}

<!-- ===== PAGE HEADER ===== -->
<section class="page-header-premium">
    <div class="container">
        <h1>Gallery</h1>
        <p>Flavours, recipe books and creations from our community.</p>
        <div class="breadcrumb-chip">
            <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Home</a>
            <i class="fas fa-chevron-right" style="font-size:.6rem;opacity:.7"></i>
            <span>Gallery</span>
        </div>
    </div>
</section>

<section class="py-5" style="padding-top:4rem !important;padding-bottom:4.5rem !important;">
    <div class="container">
        @if (types.Count > 1)
        {
            <div class="d-flex flex-wrap justify-content-center gap-2 mb-4" id="galleryFilters">
                <button type="button" class="filter-chip active" data-filter="all">Everything</button>
                @foreach (var type in types)
                {
                    var label = type switch
                    {
                        "recipe" => "Flavours",
                        "book" => "Books",
                        "user" => "Community",
                        _ => type
                    };
                    <button type="button" class="filter-chip" data-filter="@type">@label</button>
                }
            </div>
        }

        @if (items.Count == 0)
        {
            <div class="text-center py-5 surface-card p-5" data-aos="fade-up">
                <i class="fas fa-images fa-3x mb-3" style="color:var(--rose)"></i>
                <h4 class="fw-bold">Nothing here yet</h4>
                <p class="text-muted mb-4">Our gallery fills up as new flavours and community recipes are published.</p>
                <a asp-controller="Home" asp-action="Product" class="btn btn-primary">Browse flavours</a>
            </div>
        }
        else
        {
            <div class="row g-4" id="galleryGrid">
                @foreach (var item in items)
                {
                    var imgSrc = string.IsNullOrEmpty(item.ImagePath) ? Url.Content("~/img/product-1.jpg") : Url.Content(item.ImagePath);
                    var badge = item.Type switch
                    {
                        "recipe" => "Flavour",
                        "book" => "Book",
                        "user" => "Community",
                        _ => item.Type
                    };

                    <div class="col-lg-4 col-md-6 gallery-cell" data-type="@item.Type" data-aos="zoom-in">
                        <div class="gallery-item h-100 d-flex flex-column">
                            <div class="position-relative overflow-hidden" style="aspect-ratio:4/3;">
                                <img src="@imgSrc" alt="@item.Name" class="img-cover" loading="lazy" />
                                <span class="product-badge">@badge</span>
                            </div>
                            <div class="p-4 d-flex flex-column flex-grow-1">
                                <h5 class="fw-bold mb-1" style="font-family:'Playfair Display',serif;font-size:1.12rem">@item.Name</h5>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <p class="small text-muted mb-2">@item.Description</p>
                                }
                                <div class="mt-auto d-flex align-items-center justify-content-between pt-2">
                                    @if (item.Price > 0)
                                    {
                                        <span class="fw-bold" style="color:var(--rose-ink)">$@item.Price.ToString("0.00")</span>
                                    }
                                    else
                                    {
                                        <span class="small text-muted">@(item.Author ?? "iCREAM")</span>
                                    }
                                    @if (item.Type == "book")
                                    {
                                        <a asp-controller="Book" asp-action="Index" class="btn btn-sm btn-outline-primary">Shop</a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var chips = document.querySelectorAll('#galleryFilters .filter-chip');
            var cells = document.querySelectorAll('#galleryGrid .gallery-cell');
            if (!chips.length || !cells.length) return;

            chips.forEach(function (chip) {
                chip.addEventListener('click', function () {
                    chips.forEach(function (c) { c.classList.remove('active'); });
                    chip.classList.add('active');
                    var filter = chip.getAttribute('data-filter');

                    cells.forEach(function (cell) {
                        var match = filter === 'all' || cell.getAttribute('data-type') === filter;
                        cell.style.display = match ? '' : 'none';
                    });
                });
            });
        });
    </script>
}
