@model Ice_Cream_Parlour_Eproject.Models.User
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Profile";

    var displayName = !string.IsNullOrWhiteSpace(Model.FullName) ? Model.FullName : (Model.UserName ?? "Member");
    var initials = "U";
    var nameParts = displayName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
    if (nameParts.Length >= 2)
    {
        initials = string.Concat(nameParts[0][0], nameParts[1][0]).ToUpperInvariant();
    }
    else if (nameParts.Length == 1 && nameParts[0].Length > 0)
    {
        initials = nameParts[0][0].ToString().ToUpperInvariant();
    }

    var membershipActive = Model.IsPaid && Model.PaymentExpiry.HasValue && Model.PaymentExpiry.Value > DateTime.UtcNow;
}

<section class="page-header-premium">
    <div class="container">
        <h1>My profile</h1>
        <p>Manage your details, avatar and membership.</p>
        <div class="breadcrumb-chip">
            <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Home</a>
            <i class="fas fa-chevron-right" style="font-size:.6rem;opacity:.7"></i>
            <span>Profile</span>
        </div>
    </div>
</section>

<section class="py-5" style="padding-top:3.5rem !important;padding-bottom:4.5rem !important;">
    <div class="container">
        <div class="row g-4 g-lg-4">
            <!-- ===== IDENTITY CARD ===== -->
            <div class="col-lg-4" data-aos="fade-right">
                <div class="surface-card p-4 text-center h-100">
                    <div class="position-relative d-inline-block mb-3">
                        @if (!string.IsNullOrEmpty(Model.ProfilePicture))
                        {
                            <img src="@Model.ProfilePicture" alt="@displayName" class="rounded-circle" style="width:132px;height:132px;object-fit:cover;border:4px solid #fff;box-shadow:var(--sh-md)" />
                        }
                        else
                        {
                            <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto" style="width:132px;height:132px;background:var(--grad-rose);color:#fff;font-size:2.6rem;font-weight:800;border:4px solid #fff;box-shadow:var(--sh-md)">@initials</div>
                        }
                        <button type="button" class="btn btn-primary rounded-circle position-absolute" style="width:40px;height:40px;right:0;bottom:0;display:grid;place-items:center" onclick="document.getElementById('fileInput').click();" aria-label="Change profile picture">
                            <i class="fas fa-camera" style="font-size:.85rem"></i>
                        </button>
                    </div>

                    <h4 class="fw-bold mb-1">@displayName</h4>
                    <p class="small text-muted mb-3">@Model.Email</p>

                    @if (membershipActive)
                    {
                        <span class="badge-status badge-completed"><i class="fas fa-crown"></i> Premium member</span>
                    }
                    else
                    {
                        <span class="badge-status badge-inactive"><i class="fas fa-user"></i> Free account</span>
                    }

                    <hr class="my-4" />

                    <div class="row text-center g-2">
                        <div class="col-6">
                            <div class="small text-muted">Member since</div>
                            <div class="fw-semibold small">@Model.CreatedAt.ToString("MMM yyyy")</div>
                        </div>
                        <div class="col-6">
                            <div class="small text-muted">Phone</div>
                            <div class="fw-semibold small">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "—" : Model.PhoneNumber)</div>
                        </div>
                    </div>

                    <form id="profilePicForm" asp-action="UpdateProfilePicture" method="post" enctype="multipart/form-data" class="d-none">
                        @Html.AntiForgeryToken()
                        <input type="file" id="fileInput" name="profilePicture" accept="image/jpeg,image/png,image/gif,image/webp" onchange="document.getElementById('profilePicForm').submit();" />
                    </form>
                    <p class="small text-muted mt-3 mb-0"><i class="fas fa-circle-info me-1"></i>JPG, PNG, GIF or WebP · max 2 MB</p>
                </div>
            </div>

            <!-- ===== DETAILS + ACTIONS ===== -->
            <div class="col-lg-8" data-aos="fade-left">
                <div class="surface-card p-4 p-lg-4 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0">Account details</h5>
                        <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#editProfileForm" aria-expanded="false">
                            <i class="fas fa-pen me-1"></i>Edit
                        </button>
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="small text-muted">Full name</div>
                            <div class="fw-semibold">@displayName</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="small text-muted">Email</div>
                            <div class="fw-semibold">@Model.Email</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="small text-muted">Phone</div>
                            <div class="fw-semibold">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="small text-muted">Membership</div>
                            <div class="fw-semibold">@(membershipActive ? "Premium (active)" : "Free")</div>
                        </div>
                        <div class="col-12">
                            <div class="small text-muted">Address</div>
                            <div class="fw-semibold">@(string.IsNullOrEmpty(Model.Address) ? "Not provided" : Model.Address)</div>
                        </div>
                    </div>

                    <div class="collapse mt-4" id="editProfileForm">
                        <hr />
                        <form asp-action="UpdateProfile" method="post" class="row g-3">
                            @Html.AntiForgeryToken()
                            <div class="col-md-6">
                                <label class="form-label" for="fullName">Full name</label>
                                <input id="fullName" name="fullName" class="form-control" value="@Model.FullName" maxlength="100" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="phoneNumber">Phone</label>
                                <input id="phoneNumber" name="phoneNumber" class="form-control" value="@Model.PhoneNumber" maxlength="20" />
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="address">Address</label>
                                <textarea id="address" name="address" class="form-control" rows="2" maxlength="255">@Model.Address</textarea>
                            </div>
                            <div class="col-12 d-flex gap-2">
                                <button type="submit" class="btn btn-primary">Save changes</button>
                                <button type="button" class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#editProfileForm">Cancel</button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Quick actions -->
                <div class="row g-3">
                    <div class="col-md-4">
                        <a asp-controller="Order" asp-action="MyOrders" class="surface-card p-3 d-flex align-items-center gap-3 h-100 text-decoration-none hover-lift">
                            <div class="stat-icon"><i class="fas fa-bag-shopping"></i></div>
                            <div><div class="fw-bold small">My orders</div><div class="text-muted" style="font-size:.75rem">Track purchases</div></div>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a asp-controller="Order" asp-action="Track" class="surface-card p-3 d-flex align-items-center gap-3 h-100 text-decoration-none hover-lift">
                            <div class="stat-icon blue"><i class="fas fa-location-dot"></i></div>
                            <div><div class="fw-bold small">Track an order</div><div class="text-muted" style="font-size:.75rem">Check status</div></div>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a asp-controller="Recipe" asp-action="Index" class="surface-card p-3 d-flex align-items-center gap-3 h-100 text-decoration-none hover-lift">
                            <div class="stat-icon green"><i class="fas fa-book-open"></i></div>
                            <div><div class="fw-bold small">Recipes</div><div class="text-muted" style="font-size:.75rem">Premium archive</div></div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
