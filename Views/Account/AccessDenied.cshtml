@{
    ViewData["Title"] = "Access Denied";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access Denied - iCREAM</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter', sans-serif;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #fff;
                padding: 20px;
                margin: 0;
            }

            .auth-card {
                width: 100%;
                max-width: 440px;
                background: #ffffff;
                border-radius: 20px;
                padding: 2.5rem;
                box-shadow: 0 10px 50px rgba(0,0,0,0.08);
                border: 1px solid rgba(0,0,0,0.04);
                text-align: center;
                animation: fadeInUp 0.5s ease;
            }

            @@keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .icon-danger {
                width: 80px;
                height: 80px;
                background: #FDE8ED;
                border-radius: 50%;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 2.5rem;
                color: #D45A7A;
                margin-bottom: 1.5rem;
            }

            .auth-card h2 {
                color: #2D2D2D;
                font-size: 1.75rem;
                font-weight: 700;
                margin: 0 0 0.5rem 0;
            }

            .auth-card p {
                color: #8A8A8A;
                font-size: 0.95rem;
            }

            .btn-primary-custom {
                display: inline-block;
                padding: 0.75rem 2rem;
                background: #D45A7A;
                border: none;
                border-radius: 12px;
                color: #fff;
                font-weight: 600;
                font-size: 1rem;
                cursor: pointer;
                transition: 0.3s;
                text-decoration: none;
            }

                .btn-primary-custom:hover {
                    background: #C24A6A;
                    transform: translateY(-2px);
                    box-shadow: 0 8px 25px rgba(212,90,122,0.3);
                    color: #fff;
                    text-decoration: none;
                }

            .auth-link {
                color: #D45A7A;
                font-weight: 500;
                text-decoration: none;
                transition: 0.3s;
            }

                .auth-link:hover {
                    color: #C24A6A;
                    text-decoration: underline;
                }

            .divider {
                border-top: 1px solid #F0F0F2;
                margin: 1.5rem 0 1rem;
            }

            .text-muted-custom {
                color: #8A8A8A;
                font-size: 0.875rem;
            }

            @@media (max-width: 576px) {
                .auth-card {
                    padding: 1.8rem 1.2rem;
                }

                    .auth-card h2 {
                        font-size: 1.5rem;
                    }
            }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="icon-danger">
            <i class="fas fa-ban"></i>
        </div>
        <h2>Access Denied</h2>
        <p>You don't have permission to access this page.</p>

        <a asp-controller="Home" asp-action="Index" class="btn-primary-custom" style="margin-top:0.5rem;">
            Go Home
        </a>

        <div class="divider"></div>
        <p class="text-muted-custom">
            <a asp-action="Login" class="auth-link">Sign in with different account</a>
        </p>
    </div>
</body>
</html>