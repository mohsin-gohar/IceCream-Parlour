@using Ice_Cream_Parlour_Eproject.Models.Auth
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password - iCREAM";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password - iCREAM</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter', sans-serif;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #fff;
                padding: 20px;
                margin: 0;
            }

            .auth-card {
                width: 100%;
                max-width: 440px;
                background: #ffffff;
                border-radius: 20px;
                padding: 2.5rem;
                box-shadow: 0 10px 50px rgba(0,0,0,0.08);
                border: 1px solid rgba(0,0,0,0.04);
                animation: fadeInUp 0.5s ease;
            }

            @@keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .logo-icon {
                width: 72px;
                height: 72px;
                background: #F8E1E7;
                border-radius: 20px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 2rem;
                color: #D45A7A;
                margin-bottom: 1rem;
            }

            .auth-card h1 {
                color: #2D2D2D;
                font-size: 1.75rem;
                font-weight: 700;
                margin: 0;
            }

            .auth-card .subtitle {
                color: #8A8A8A;
                font-size: 0.9rem;
                margin-top: 0.3rem;
            }

            .form-control {
                background: #F7F7F9;
                border: 1px solid #EDEDF0;
                border-radius: 12px;
                padding: 0.8rem 1rem;
                color: #2D2D2D;
                font-size: 0.9rem;
                width: 100%;
                transition: 0.3s;
            }

                .form-control:focus {
                    background: #fff;
                    border-color: #D45A7A;
                    box-shadow: 0 0 0 4px rgba(212,90,122,0.1);
                    outline: none;
                }

                .form-control::placeholder {
                    color: #B0B0B8;
                }

            label {
                color: #2D2D2D;
                font-size: 0.875rem;
                font-weight: 500;
                margin-bottom: 0.4rem;
                display: block;
            }

            .btn-primary-custom {
                width: 100%;
                padding: 0.875rem;
                background: #D45A7A;
                border: none;
                border-radius: 12px;
                color: #fff;
                font-weight: 600;
                font-size: 1rem;
                cursor: pointer;
                transition: 0.3s;
            }

                .btn-primary-custom:hover {
                    background: #C24A6A;
                    transform: translateY(-2px);
                    box-shadow: 0 8px 25px rgba(212,90,122,0.3);
                }

            .auth-link {
                color: #D45A7A;
                font-weight: 500;
                text-decoration: none;
                transition: 0.3s;
            }

                .auth-link:hover {
                    color: #C24A6A;
                    text-decoration: underline;
                }

            .divider {
                border-top: 1px solid #F0F0F2;
                margin: 1.5rem 0 1rem;
            }

            .text-muted-custom {
                color: #8A8A8A;
                font-size: 0.875rem;
            }

            .text-danger {
                color: #E74C6F !important;
                font-size: 0.8rem;
                margin-top: 0.25rem;
                display: block;
            }

            .validation-summary {
                background: #FDE8ED;
                border: 1px solid #FCCCD8;
                color: #C0395A;
                padding: 0.75rem 1rem;
                border-radius: 10px;
                font-size: 0.875rem;
                margin-bottom: 1rem;
            }

            .form-group {
                margin-bottom: 1.25rem;
            }

            @@media (max-width: 576px) {
                .auth-card {
                    padding: 1.8rem 1.2rem;
                }

                    .auth-card h1 {
                        font-size: 1.5rem;
                    }
            }
    </style>
</head>
<body>
    <div class="auth-card">
        <!-- Logo -->
        <div style="text-align:center;">
            <div class="logo-icon">
                <i class="fas fa-lock"></i>
            </div>
            <h1>Reset Password</h1>
            <p class="subtitle">Enter your new password below</p>
        </div>

        <!-- Success/Error Message -->
        @if (TempData["Success"] != null)
        {
            <div style="background:#E8F8F0; border:1px solid #B8E6D0; color:#1D8A5A; padding:0.75rem 1rem; border-radius:10px; font-size:0.875rem; margin-bottom:1rem;">
                <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div style="background:#FDE8ED; border:1px solid #FCCCD8; color:#C0395A; padding:0.75rem 1rem; border-radius:10px; font-size:0.875rem; margin-bottom:1rem;">
                <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
            </div>
        }

        <!-- Form -->
        <form asp-action="ResetPassword" method="post" style="margin-top:1.5rem;">
            @Html.AntiForgeryToken()

            <!-- Hidden fields for Email and Token (passed via URL) -->
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <!-- New Password -->
            <div class="form-group">
                <label asp-for="NewPassword">New Password</label>
                <input asp-for="NewPassword" class="form-control" placeholder="Enter new password" type="password" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <!-- Confirm Password -->
            <div class="form-group">
                <label asp-for="ConfirmPassword">Confirm Password</label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm new password" type="password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <!-- Submit -->
            <button type="submit" class="btn-primary-custom">
                <i class="fas fa-check me-2"></i> Reset Password
            </button>
        </form>

        <!-- Links -->
        <div class="divider"></div>
        <div style="text-align:center;">
            <p class="text-muted-custom">
                <a asp-action="Login" class="auth-link">
                    <i class="fas fa-arrow-left me-1"></i> Back to login
                </a>
            </p>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>