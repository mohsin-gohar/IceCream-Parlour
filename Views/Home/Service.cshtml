@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Our Services - iCREAM";
}
<style>
    /* ===== PAGE HEADER ===== */
    .page-header {
        background: linear-gradient(135deg, #3D0C11 0%, #6B1A23 50%, #8B2A3A 100%);
        min-height: 350px;
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
    }

        .page-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('/img/pattern-overlay.png') repeat;
            opacity: 0.1;
        }

    /* ===== COUNTER SECTION ===== */
    .counter-section {
        background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
        padding: 60px 0;
    }

    .counter-item {
        transition: all 0.3s ease;
        border: 1px solid rgba(212, 175, 55, 0.1);
    }

        .counter-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 40px rgba(0,0,0,0.08);
        }

    .counter-icon {
        transition: all 0.3s ease;
    }

    .counter-item:hover .counter-icon {
        transform: scale(1.1);
    }

    /* ===== SERVICES SECTION ===== */
    .services-section {
        padding: 80px 0;
        background: #ffffff;
    }

    .service-card {
        transition: all 0.4s ease;
        border: 1px solid rgba(0,0,0,0.05);
        position: relative;
        overflow: hidden;
    }

        .service-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(212, 175, 55, 0.03) 0%, transparent 100%);
            opacity: 0;
            transition: all 0.4s ease;
        }

        .service-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 50px rgba(212, 175, 55, 0.15);
            border-color: #D4AF37;
        }

            .service-card:hover::before {
                opacity: 1;
            }

    .service-icon {
        transition: all 0.4s ease;
    }

    .service-card:hover .service-icon {
        transform: rotateY(360deg);
        background: #D4AF37 !important;
    }

    /* ===== TESTIMONIAL SECTION ===== */
    .testimonial-card {
        transition: all 0.4s ease;
        border: 1px solid rgba(0,0,0,0.05);
    }

        .testimonial-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 50px rgba(0,0,0,0.08);
        }

    .avatar-circle {
        background: linear-gradient(135deg, #D4AF37, #F5D76E);
        color: #3D0C11 !important;
    }

    /* ===== SECTION TITLE ===== */
    .section-title h4 {
        letter-spacing: 2px;
        position: relative;
        display: inline-block;
    }

        .section-title h4::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 50%;
            transform: translateX(-50%);
            width: 40px;
            height: 3px;
            background: #D4AF37;
        }

    /* ===== BACK TO TOP ===== */
    .back-to-top {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: #D4AF37;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
        z-index: 999;
        border: none;
        text-decoration: none;
    }

        .back-to-top.show {
            opacity: 1;
            visibility: visible;
        }

        .back-to-top:hover {
            background: #3D0C11;
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 5px 20px rgba(0,0,0,0.2);
        }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 768px) {
        .counter-item {
            margin-bottom: 20px;
        }

        .service-card {
            margin-bottom: 20px;
        }

        .testimonial-card {
            margin-bottom: 20px;
        }

        .page-header {
            min-height: 250px;
        }

            .page-header h1 {
                font-size: 2rem;
            }
    }
</style>
