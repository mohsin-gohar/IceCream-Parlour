@model IEnumerable<Ice_Cream_Parlour_Eproject.Models.Recipe>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Products - iCREAM";
}

<!-- Header Start -->
<div class="jumbotron jumbotron-fluid page-header" style="margin-bottom: 50px; background-image:url('/img/header.jpg'); background-size: cover; background-position: center; min-height: 250px; display: flex; align-items: center; justify-content: center;">
    <div class="container text-center py-5">
        <h1 class="text-white display-3 mt-lg-5" style="font-family: 'Playfair Display', serif;">Our Ice Cream Products</h1>
        <div class="d-inline-flex align-items-center text-white">
            <p class="m-0"><a class="text-white fw-bold" asp-action="Index" asp-controller="Home">Home</a></p>
            <i class="fa fa-circle px-3 text-primary"></i>
            <p class="m-0 text-white-50">Products</p>
        </div>
    </div>
</div>
<!-- Header End -->

<!-- Products Start -->
<div class="container-fluid py-5">
    <div class="container py-3">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <h1 class="section-title position-relative text-center mb-5" style="font-family: 'Playfair Display', serif;">Best Prices We Offer For Ice Cream Lovers</h1>
            </div>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-ice-cream fa-4x text-muted mb-3"></i>
                <h4 class="text-muted">No products available at the moment</h4>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var p in Model)
                {
                    var imgSrc = !string.IsNullOrEmpty(p.ImagePath) ? p.ImagePath : "/img/product-1.jpg";
                    <div class="col-lg-3 col-md-6 mb-4">
                        <div class="product-item d-flex flex-column align-items-center text-center bg-light rounded py-5 px-3 h-100 shadow-sm border" style="transition: all 0.3s ease;">
                            <div class="bg-primary mt-n5 py-3 rounded-pill shadow-sm" style="width: 100px;">
                                <h4 class="font-weight-bold text-white mb-0">$@p.Price.ToString("0.00")</h4>
                            </div>
                            <div class="position-relative bg-primary rounded-circle mt-n3 mb-4 p-2" style="width: 150px; height: 150px; overflow: hidden;">
                                <img class="rounded-circle w-100 h-100" src="@imgSrc" style="object-fit: cover;" alt="@p.Name">
                            </div>
                            <h5 class="font-weight-bold mb-2" style="font-family: 'Playfair Display', serif;">@p.Name</h5>
                            <p class="text-muted small mb-4 flex-grow-1">@p.Category</p>
                            <a asp-controller="Book" asp-action="Index" class="btn btn-sm btn-secondary rounded-pill px-4 py-2 fw-bold">
                                Order Now <i class="fas fa-shopping-cart ms-1"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
<!-- Products End -->
