@model IEnumerable<Ice_Cream_Parlour_Eproject.Models.Recipe>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Products";
    var recipes = Model?.ToList() ?? new List<Ice_Cream_Parlour_Eproject.Models.Recipe>();
    var categories = recipes.Select(r => r.Category).Where(c => !string.IsNullOrWhiteSpace(c)).Distinct().OrderBy(c => c).ToList();
}

<!-- ===== PAGE HEADER ===== -->
<section class="page-header-premium">
    <div class="container">
        <h1>The menu</h1>
        <p>Churned fresh every morning. Seasonal flavours rotate weekly.</p>
        <div class="breadcrumb-chip">
            <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Home</a>
            <i class="fas fa-chevron-right" style="font-size:.6rem;opacity:.7"></i>
            <span>Products</span>
        </div>
    </div>
</section>

<section class="py-5" style="padding-top:4rem !important;padding-bottom:4.5rem !important;">
    <div class="container">
        @if (categories.Count > 1)
        {
            <div class="d-flex flex-wrap justify-content-center gap-2 mb-4" id="productFilters">
                <button type="button" class="filter-chip active" data-filter="all">All flavours</button>
                @foreach (var category in categories)
                {
                    <button type="button" class="filter-chip" data-filter="@category">@category</button>
                }
            </div>
        }

        @if (recipes.Count == 0)
        {
            <div class="text-center py-5 surface-card p-5" data-aos="fade-up">
                <i class="fas fa-ice-cream fa-3x mb-3" style="color:var(--rose)"></i>
                <h4 class="fw-bold">The churn is empty</h4>
                <p class="text-muted mb-4">No flavours are published yet. Check back shortly or browse our recipe books.</p>
                <a asp-controller="Book" asp-action="Index" class="btn btn-primary">Browse recipe books</a>
            </div>
        }
        else
        {
            <div class="row g-4" id="productGrid">
                @foreach (var p in recipes)
                {
                    var imgSrc = string.IsNullOrEmpty(p.ImagePath) ? Url.Content("~/img/product-1.jpg") : Url.Content(p.ImagePath);
                    <div class="col-lg-3 col-md-6 product-cell" data-category="@p.Category" data-aos="fade-up">
                        <div class="product-card h-100 d-flex flex-column">
                            <div class="product-image ratio ratio-1x1">
                                <span class="product-badge">@(p.IsFree ? "Free recipe" : "Premium")</span>
                                <img src="@imgSrc" alt="@p.Name" loading="lazy" />
                            </div>
                            <div class="product-body d-flex flex-column flex-grow-1">
                                <h5 class="product-title">@p.Name</h5>
                                <p class="product-description small text-muted mb-2">@p.Category</p>
                                <div class="product-price mt-auto">
                                    <span class="current-price">$@p.Price.ToString("0.00")</span>
                                    @if (p.IsFree)
                                    {
                                        <span class="old-price">$@((p.Price + 2).ToString("0.00"))</span>
                                    }
                                </div>
                                <div class="d-grid gap-2">
                                    <a asp-controller="Recipe" asp-action="Details" asp-route-id="@p.Id" class="btn-order">
                                        View recipe <i class="fas fa-arrow-right"></i>
                                    </a>
                                    <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-secondary btn-sm">
                                        <i class="fas fa-shopping-bag me-1"></i>Order a tub
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <p class="text-center text-muted small mt-4 mb-0" id="noFilterResults" style="display:none">
                No flavours in this category yet.
            </p>
        }
    </div>
</section>

<section class="py-5 bg-cream">
    <div class="container">
        <div class="row align-items-center g-4 surface-card p-4 p-lg-5" data-aos="fade-up" style="border-radius:var(--r-xl)">
            <div class="col-lg-8">
                <span class="eyebrow">Allergies?</span>
                <h2 class="mt-2 mb-2" style="font-size:1.7rem">We will find you a safe scoop</h2>
                <p class="text-muted mb-0">Most sorbets are dairy free and several flavours can be made without nuts. Tell us what you need and we will talk you through the batch notes.</p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <a asp-controller="Home" asp-action="Contact" class="btn btn-primary btn-lg">Ask us anything</a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var chips = document.querySelectorAll('#productFilters .filter-chip');
            var cells = document.querySelectorAll('#productGrid .product-cell');
            if (!chips.length || !cells.length) return;

            chips.forEach(function (chip) {
                chip.addEventListener('click', function () {
                    chips.forEach(function (c) { c.classList.remove('active'); });
                    chip.classList.add('active');

                    var filter = chip.getAttribute('data-filter');
                    var visible = 0;

                    cells.forEach(function (cell) {
                        var match = filter === 'all' || cell.getAttribute('data-category') === filter;
                        cell.style.display = match ? '' : 'none';
                        if (match) visible++;
                    });

                    var empty = document.getElementById('noFilterResults');
                    if (empty) empty.style.display = visible === 0 ? 'block' : 'none';
                });
            });
        });
    </script>
}
