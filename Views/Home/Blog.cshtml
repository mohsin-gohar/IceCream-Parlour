@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Journal";

    var posts = new[]
    {
        new {
            Title = "Why we churn in 20-litre batches",
            Category = "Craft",
            Date = "12 October 2026",
            Excerpt = "Small batches are slower and more expensive — but they are the only way to catch a batch that is slightly off before it reaches a customer.",
            Image = "product-2.jpg",
            Read = "4 min read"
        },
        new {
            Title = "The vanilla pod test",
            Category = "Ingredients",
            Date = "28 September 2026",
            Excerpt = "We tasted nine vanilla origins side by side. Madagascar won on floral depth, but a Tahitian pod made a surprising comeback in the finish.",
            Image = "product-1.jpg",
            Read = "6 min read"
        },
        new {
            Title = "How to keep ice cream soft at home",
            Category = "Kitchen tips",
            Date = "9 September 2026",
            Excerpt = "The freezer is the enemy of texture. Three small changes — temperature, container, and a splash of milk — make a real difference.",
            Image = "product-4.jpg",
            Read = "3 min read"
        },
        new {
            Title = "Building a flavour: salted butterscotch",
            Category = "Craft",
            Date = "21 August 2026",
            Excerpt = "Forty-one test batches later, here is what we learned about caramel bitterness, salt ratios and the moment to stop stirring.",
            Image = "product-5.jpg",
            Read = "7 min read"
        },
        new {
            Title = "Meet the farm behind our milk",
            Category = "People",
            Date = "2 August 2026",
            Excerpt = "A 40-minute drive from the parlour, the Hendricks family has been supplying us with the same herd since 2006.",
            Image = "gallery5.jpg",
            Read = "5 min read"
        },
        new {
            Title = "Sorbet season is coming",
            Category = "Seasonal",
            Date = "18 July 2026",
            Excerpt = "Mango, blackcurrant and blood orange are back. Here is how we keep sorbet from turning into a block of ice.",
            Image = "product-3.jpg",
            Read = "4 min read"
        }
    };
}

<section class="page-header-premium">
    <div class="container">
        <h1>The journal</h1>
        <p>Notes from the kitchen, flavour science and parlour news.</p>
        <div class="breadcrumb-chip">
            <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Home</a>
            <i class="fas fa-chevron-right" style="font-size:.6rem;opacity:.7"></i>
            <span>Journal</span>
        </div>
    </div>
</section>

<section class="py-5" style="padding-top:4rem !important;padding-bottom:4.5rem !important;">
    <div class="container">
        <div class="row g-4">
            @foreach (var post in posts)
            {
                <div class="col-lg-4 col-md-6" data-aos="fade-up">
                    <article class="surface-card h-100 d-flex flex-column overflow-hidden hover-lift">
                        <div class="position-relative overflow-hidden" style="aspect-ratio:16/10">
                            <img src="~/img/@post.Image" alt="@post.Title" class="img-cover" loading="lazy" />
                            <span class="product-badge">@post.Category</span>
                        </div>
                        <div class="p-4 d-flex flex-column flex-grow-1">
                            <div class="d-flex align-items-center gap-2 small text-muted mb-2">
                                <span>@post.Date</span>
                                <span>·</span>
                                <span>@post.Read</span>
                            </div>
                            <h5 class="fw-bold mb-2" style="font-family:'Playfair Display',serif;line-height:1.35">@post.Title</h5>
                            <p class="small text-muted mb-3">@post.Excerpt</p>
                            <a asp-controller="Home" asp-action="Contact" class="small fw-bold mt-auto text-decoration-none" style="color:var(--rose-ink)">
                                Read the story <i class="fas fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </article>
                </div>
            }
        </div>

        <div class="row justify-content-center mt-5">
            <div class="col-lg-8 text-center surface-card p-4 p-lg-5" data-aos="fade-up">
                <span class="eyebrow justify-content-center">Newsletter</span>
                <h3 class="mt-2 mb-2">One good e-mail a month</h3>
                <p class="text-muted mb-4">Flavour drops, kitchen notes and member offers. Unsubscribe any time.</p>
                <form class="d-flex flex-column flex-sm-row gap-2 justify-content-center" onsubmit="return false;">
                    <input type="email" class="form-control" style="max-width:320px" placeholder="you@example.com" aria-label="Email address" required />
                    <button type="submit" class="btn btn-primary">Subscribe</button>
                </form>
            </div>
        </div>
    </div>
</section>
