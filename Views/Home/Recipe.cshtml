@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Recipe Management - iCREAM";
}
<!-- ===== PAGE HEADER ===== -->
<div style="background-image:url('/img/header.jpg');  min-height: 180px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; color: white; border-radius: 0 0 30px 30px; padding: 30px 20px;">
    <h1 style="font-size: 2.2rem; font-weight: 700;"><i class="fas fa-utensils me-3"></i> Recipe Management</h1>
    <p style="font-size: 1rem; opacity: 0.9;">Manage your recipes — all data stored locally</p>
</div>

<!-- ===== TOGGLE BUTTON ===== -->
<div style="max-width: 1200px; margin: 20px auto 10px; padding: 0 20px; text-align: center;">
    <button id="toggleFormBtn" onclick="toggleForm()" style="background: linear-gradient(135deg, #F195B2, #62C3E7); color: #fff; border: none; padding: 12px 35px; border-radius: 50px; font-weight: 600; font-size: 1rem; cursor: pointer; transition: 0.3s; box-shadow: 0 4px 15px rgba(241,149,178,0.3);"
            onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='0 8px 25px rgba(241,149,178,0.4)';"
            onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(241,149,178,0.3)';">
        <i class="fas fa-plus-circle me-2"></i> Add New Recipe
    </button>
</div>

<!-- ===== ADD / EDIT FORM (HIDDEN BY DEFAULT) ===== -->
<div id="recipeFormContainer" style="max-width: 700px; margin: 20px auto; padding: 0 20px; display: none;">
    <div style="background: #fff; border-radius: 20px; box-shadow: 0 5px 30px rgba(0,0,0,0.1); padding: 25px 30px; border: 1px solid rgba(241,149,178,0.08);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <h4 style="font-weight: 700; color: #2d2d2d;" id="formTitle">Add New Recipe</h4>
            <button onclick="toggleForm()" style="background: none; border: none; font-size: 1.5rem; color: #999; cursor: pointer; transition: 0.3s;" onmouseover="this.style.color='#dc3545';" onmouseout="this.style.color='#999';">&times;</button>
        </div>
        <form id="recipeForm" onsubmit="saveRecipe(event)">
            <input type="hidden" id="recipeId" value="0" />
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                <div>
                    <label style="font-weight: 600; font-size: 0.85rem; color: #444;">Name *</label>
                    <input type="text" id="recipeName" required placeholder="e.g. Vanilla Bliss" style="width:100%; padding: 10px 14px; border:1.5px solid #e0e0e0; border-radius:10px; font-size:0.95rem; transition:0.3s; background:#fafafa;" />
                </div>
                <div>
                    <label style="font-weight: 600; font-size: 0.85rem; color: #444;">Category *</label>
                    <select id="recipeCategory" style="width:100%; padding: 10px 14px; border:1.5px solid #e0e0e0; border-radius:10px; font-size:0.95rem; background:#fafafa;">
                        <option value="Classic">Classic</option>
                        <option value="Fruit">Fruit</option>
                        <option value="Premium">Premium</option>
                        <option value="Special">Special</option>
                    </select>
                </div>
            </div>
            <div style="margin-top: 12px;">
                <label style="font-weight: 600; font-size: 0.85rem; color: #444;">Ingredients (comma separated) *</label>
                <input type="text" id="recipeIngredients" required placeholder="e.g. Fresh cream, vanilla extract, sugar" style="width:100%; padding: 10px 14px; border:1.5px solid #e0e0e0; border-radius:10px; font-size:0.95rem; background:#fafafa;" />
            </div>
            <div style="margin-top: 12px;">
                <label style="font-weight: 600; font-size: 0.85rem; color: #444;">Procedure *</label>
                <textarea id="recipeProcedure" rows="3" required placeholder="Step by step instructions" style="width:100%; padding: 10px 14px; border:1.5px solid #e0e0e0; border-radius:10px; font-size:0.95rem; background:#fafafa; resize:vertical;"></textarea>
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 15px; margin-top: 12px;">
                <div style="flex:1; min-width: 200px;">
                    <label style="font-weight: 600; font-size: 0.85rem; color: #444;">Image (local file)</label>
                    <input type="file" id="recipeImageFile" accept="image/*" style="width:100%; padding: 8px; border:1.5px solid #e0e0e0; border-radius:10px; font-size:0.95rem; background:#fafafa;" />
                    <div id="imagePreview" style="margin-top: 8px; display: none;">
                        <img id="imagePreviewImg" src="" alt="Preview" style="max-width: 100px; max-height: 100px; border-radius: 10px; border: 2px solid #F195B2;" />
                        <button type="button" onclick="clearImage()" style="background: none; border: none; color: #dc3545; cursor: pointer; font-size: 0.8rem;">Remove</button>
                    </div>
                </div>
                <div style="display: flex; align-items: center; gap: 10px; padding-top: 6px;">
                    <label style="font-weight: 600; font-size: 0.85rem; color: #444;">Free?</label>
                    <input type="checkbox" id="recipeIsFree" checked style="width:20px; height:20px;" />
                </div>
            </div>
            <button type="submit" id="submitBtn" style="background: linear-gradient(135deg, #F195B2, #62C3E7); color: #fff; border: none; padding: 12px 20px; border-radius: 50px; font-weight: 600; font-size: 1rem; cursor: pointer; width:100%; margin-top: 16px; transition:0.3s;">Add Recipe</button>
        </form>
    </div>
</div>

<!-- ===== RECIPE LIST ===== -->
<div style="max-width: 1200px; margin: 0 auto; padding: 0 20px 40px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h3 style="font-weight: 700; color: #2d2d2d;">Your Recipes</h3>
        <span id="recipeCount" style="background: #f0ecee; padding: 4px 14px; border-radius: 50px; font-size: 0.85rem;">0 recipes</span>
    </div>
    <div id="recipeGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 25px;">
        <!-- Recipes will be rendered here -->
    </div>
</div>

<!-- ===== BACK TO TOP ===== -->
<a href="#" style="position: fixed; bottom: 30px; right: 30px; width: 44px; height: 44px; background: linear-gradient(135deg, #F195B2, #62C3E7); color: #fff; border: none; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 18px; box-shadow: 0 6px 20px rgba(241,149,178,0.4); text-decoration: none; z-index: 999; transition:0.3s;"
   onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='0 10px 30px rgba(241,149,178,0.5)';"
   onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 6px 20px rgba(241,149,178,0.4)';">
    <i class="fa fa-angle-double-up"></i>
</a>

<!-- ============================================================ -->
<!-- ===== JAVASCRIPT - ALL LOGIC ===== -->
<!-- ============================================================ -->
<script>
    // ===== INITIAL RECIPE DATA (JSON) =====
    let recipes = [
        {
            id: 1,
            name: "Madagascar Vanilla",
            category: "Classic",
            ingredients: "Fresh cream, vanilla extract, sugar, milk",
            procedure: "Mix all ingredients. Churn in ice cream maker. Freeze for 4 hours.",
            image: "",
            isFree: true
        },
        {
            id: 2,
            name: "Chocolate Fudge",
            category: "Classic",
            ingredients: "Fresh cream, cocoa powder, sugar, milk, chocolate chips",
            procedure: "Mix cocoa with sugar. Add cream and milk. Churn and freeze.",
            image: "",
            isFree: false
        },
        {
            id: 3,
            name: "Strawberry Bliss",
            category: "Fruit",
            ingredients: "Fresh strawberries, cream, sugar, milk",
            procedure: "Blend strawberries. Mix with cream and sugar. Churn and freeze.",
            image: "",
            isFree: true
        },
        {
            id: 4,
            name: "Salted Caramel",
            category: "Premium",
            ingredients: "Cream, butterscotch syrup, sugar, milk, cashews",
            procedure: "Mix butterscotch syrup with cream. Add sugar and milk. Churn and freeze.",
            image: "",
            isFree: false
        }
    ];

    // ===== LOAD FROM LOCAL STORAGE =====
    function loadFromStorage() {
        const stored = localStorage.getItem('recipesData');
        if (stored) {
            try {
                recipes = JSON.parse(stored);
            } catch (e) { /* ignore */ }
        } else {
            localStorage.setItem('recipesData', JSON.stringify(recipes));
        }
    }

    function saveToStorage() {
        localStorage.setItem('recipesData', JSON.stringify(recipes));
    }

    // ===== TOGGLE FORM VISIBILITY =====
    let isFormVisible = false;

    function toggleForm() {
        const container = document.getElementById('recipeFormContainer');
        const btn = document.getElementById('toggleFormBtn');
        if (isFormVisible) {
            container.style.display = 'none';
            btn.innerHTML = '<i class="fas fa-plus-circle me-2"></i> Add New Recipe';
            isFormVisible = false;
        } else {
            container.style.display = 'block';
            btn.innerHTML = '<i class="fas fa-times-circle me-2"></i> Close Form';
            isFormVisible = true;
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    }

    // ===== IMAGE HANDLING =====
    let currentImageData = '';

    document.getElementById('recipeImageFile').addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (!file) return;

        // Validate file size (max 2MB)
        if (file.size > 2 * 1024 * 1024) {
            alert('Image size must be less than 2MB.');
            this.value = '';
            return;
        }

        // Validate file type
        if (!file.type.startsWith('image/')) {
            alert('Please select an image file.');
            this.value = '';
            return;
        }

        const reader = new FileReader();
        reader.onload = function(ev) {
            currentImageData = ev.target.result;
            document.getElementById('imagePreviewImg').src = currentImageData;
            document.getElementById('imagePreview').style.display = 'block';
        };
        reader.readAsDataURL(file);
    });

    function clearImage() {
        currentImageData = '';
        document.getElementById('recipeImageFile').value = '';
        document.getElementById('imagePreview').style.display = 'none';
        document.getElementById('imagePreviewImg').src = '';
    }

    // ===== RENDER RECIPES =====
    function renderRecipes() {
        const grid = document.getElementById('recipeGrid');
        const count = document.getElementById('recipeCount');
        if (recipes.length === 0) {
            grid.innerHTML = `
                <div style="text-align: center; padding: 60px 20px; grid-column: 1 / -1;">
                    <i class="fas fa-utensils fa-3x text-muted mb-3"></i>
                    <h4 style="color: #888;">No recipes yet</h4>
                    <p style="color: #aaa;">Add your first recipe using the form above!</p>
                </div>
            `;
            count.textContent = '0 recipes';
            return;
        }

        let html = '';
        recipes.forEach(r => {
            const imgSrc = r.image && r.image.startsWith('data:image') ? r.image : (r.image || 'https://via.placeholder.com/300x300?text=Recipe');
            html += `
                <div class="recipe-card" style="background: #fff; border-radius: 20px; overflow: hidden; box-shadow: 0 5px 20px rgba(0,0,0,0.06); border: 1px solid rgba(241,149,178,0.06); transition: 0.3s;">
                    <div style="overflow: hidden; position: relative; aspect-ratio: 1/1; background: #f8f5f6;">
                        <img src="${imgSrc}" alt="${r.name}" style="width:100%; height:100%; object-fit:cover; transition:0.3s;" />
                        <span style="position: absolute; top: 12px; left: 12px; background: ${r.isFree ? 'linear-gradient(135deg, #28a745, #20c997)' : 'linear-gradient(135deg, #F195B2, #62C3E7)'}; color: #fff; padding: 4px 14px; border-radius: 50px; font-size: 11px; font-weight: 700; text-transform: uppercase; box-shadow: 0 4px 15px rgba(241,149,178,0.3);">
                            ${r.isFree ? 'Free Access' : 'Premium'}
                        </span>
                    </div>
                    <div style="padding: 16px 18px 18px;">
                        <h5 style="font-size: 1.1rem; font-weight: 700; color: #2d2d2d; margin-bottom: 4px;">${r.name}</h5>
                        <div style="display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.75rem; color: #6a5f64; margin: 4px 0 10px;">
                            <span><i class="fas fa-tag" style="color: #F195B2;"></i> ${r.category}</span>
                        </div>
                        <p style="font-size: 0.85rem; color: #5c5458; line-height: 1.4; margin-bottom: 12px;">${r.ingredients.length > 70 ? r.ingredients.substring(0, 70) + '...' : r.ingredients}</p>
                        <div style="display: flex; gap: 8px;">
                            <button onclick="editRecipe(${r.id})" style="flex:1; padding: 6px; border: 1px solid #F195B2; border-radius: 30px; background: transparent; color: #F195B2; font-weight: 600; font-size: 0.8rem; cursor: pointer; transition: 0.3s;" onmouseover="this.style.background='#F195B2'; this.style.color='#fff';" onmouseout="this.style.background='transparent'; this.style.color='#F195B2';">Edit</button>
                            <button onclick="deleteRecipe(${r.id})" style="flex:1; padding: 6px; border: 1px solid #dc3545; border-radius: 30px; background: transparent; color: #dc3545; font-weight: 600; font-size: 0.8rem; cursor: pointer; transition: 0.3s;" onmouseover="this.style.background='#dc3545'; this.style.color='#fff';" onmouseout="this.style.background='transparent'; this.style.color='#dc3545';">Delete</button>
                        </div>
                    </div>
                </div>
            `;
        });
        grid.innerHTML = html;
        count.textContent = recipes.length + ' recipes';
    }

    // ===== CRUD OPERATIONS =====

    function saveRecipe(e) {
        e.preventDefault();
        const id = parseInt(document.getElementById('recipeId').value);
        const name = document.getElementById('recipeName').value.trim();
        const category = document.getElementById('recipeCategory').value;
        const ingredients = document.getElementById('recipeIngredients').value.trim();
        const procedure = document.getElementById('recipeProcedure').value.trim();
        const isFree = document.getElementById('recipeIsFree').checked;

        if (!name || !ingredients || !procedure) {
            alert('Please fill all required fields.');
            return;
        }

        const imageData = currentImageData;

        if (id === 0) {
            // Add new
            const newId = recipes.length > 0 ? Math.max(...recipes.map(r => r.id)) + 1 : 1;
            recipes.push({
                id: newId,
                name,
                category,
                ingredients,
                procedure,
                image: imageData,
                isFree
            });
        } else {
            // Update existing
            const index = recipes.findIndex(r => r.id === id);
            if (index !== -1) {
                recipes[index] = {
                    ...recipes[index],
                    name,
                    category,
                    ingredients,
                    procedure,
                    image: imageData || recipes[index].image,
                    isFree
                };
            }
        }

        saveToStorage();
        renderRecipes();
        resetForm();

        // Hide form after save
        if (isFormVisible) {
            toggleForm();
        }
    }

    function editRecipe(id) {
        const recipe = recipes.find(r => r.id === id);
        if (!recipe) return;

        document.getElementById('recipeId').value = recipe.id;
        document.getElementById('recipeName').value = recipe.name;
        document.getElementById('recipeCategory').value = recipe.category;
        document.getElementById('recipeIngredients').value = recipe.ingredients;
        document.getElementById('recipeProcedure').value = recipe.procedure;
        document.getElementById('recipeIsFree').checked = recipe.isFree;

        // Show existing image if any
        if (recipe.image && recipe.image.startsWith('data:image')) {
            currentImageData = recipe.image;
            document.getElementById('imagePreviewImg').src = recipe.image;
            document.getElementById('imagePreview').style.display = 'block';
        } else {
            clearImage();
        }

        document.getElementById('formTitle').innerText = 'Edit Recipe';
        document.getElementById('submitBtn').innerText = 'Update Recipe';

        // Show form if hidden
        if (!isFormVisible) {
            toggleForm();
        }
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function deleteRecipe(id) {
        if (confirm('Are you sure you want to delete this recipe?')) {
            recipes = recipes.filter(r => r.id !== id);
            saveToStorage();
            renderRecipes();
        }
    }

    function resetForm() {
        document.getElementById('recipeId').value = 0;
        document.getElementById('recipeName').value = '';
        document.getElementById('recipeCategory').value = 'Classic';
        document.getElementById('recipeIngredients').value = '';
        document.getElementById('recipeProcedure').value = '';
        document.getElementById('recipeIsFree').checked = true;
        clearImage();
        document.getElementById('formTitle').innerText = 'Add New Recipe';
        document.getElementById('submitBtn').innerText = 'Add Recipe';
    }

    // ===== INIT =====
    loadFromStorage();
    renderRecipes();
</script>