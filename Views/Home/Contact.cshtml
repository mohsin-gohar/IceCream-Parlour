@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Contact Us - iCREAM";
}

<!-- Contact Section Start -->
<div class="container-fluid contact-section py-5 wow fadeIn" data-wow-delay="0.1s">
    <div class="container py-5">
        <div class="row g-5">
            <!-- Contact Info Column -->
            <div class="col-lg-5">
                <div class="contact-info">
                    <span class="badge bg-primary text-white px-4 py-2 rounded-pill mb-3">
                        <i class="fas fa-heart me-2"></i>Get In Touch
                    </span>
                    <h2 class="display-5 fw-bold mb-3">We Are Here <span class="text-primary">For You</span></h2>
                    <p class="text-muted mb-4">Aap hamein kisi bhi waqt message ya call kar sakte hain. Hamari team jald se jald aap se rabta karegi.</p>

                    <!-- Contact Info Cards -->
                    <div class="contact-info-cards">
                        <div class="info-card d-flex align-items-start p-3 mb-3 rounded-3 bg-white shadow-sm">
                            <div class="info-icon bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px; flex-shrink: 0;">
                                <i class="fas fa-map-marker-alt"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1">Our Location</h6>
                                <p class="text-muted mb-0">123 Ice Cream Street, Karachi, Pakistan</p>
                            </div>
                        </div>

                        <div class="info-card d-flex align-items-start p-3 mb-3 rounded-3 bg-white shadow-sm">
                            <div class="info-icon bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px; flex-shrink: 0;">
                                <i class="fas fa-phone-alt"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1">Phone Number</h6>
                                <p class="text-muted mb-0">+92 300 1234567</p>
                            </div>
                        </div>

                        <div class="info-card d-flex align-items-start p-3 rounded-3 bg-white shadow-sm">
                            <div class="info-icon bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px; flex-shrink: 0;">
                                <i class="fas fa-envelope"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1">Email Address</h6>
                                <p class="text-muted mb-0">support@icream.com</p>
                            </div>
                        </div>
                    </div>

                    <!-- Social Media -->
                    <div class="social-media mt-4">
                        <h6 class="fw-bold mb-3">Follow Us</h6>
                        <div class="d-flex gap-3">
                            <a href="#" class="social-link bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; transition: all 0.3s;">
                                <i class="fab fa-facebook-f"></i>
                            </a>
                            <a href="#" class="social-link bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; transition: all 0.3s;">
                                <i class="fab fa-instagram"></i>
                            </a>
                            <a href="#" class="social-link bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; transition: all 0.3s;">
                                <i class="fab fa-twitter"></i>
                            </a>
                            <a href="#" class="social-link bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; transition: all 0.3s;">
                                <i class="fab fa-youtube"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contact Form Column -->
            <div class="col-lg-7">
                <div class="contact-form-wrapper bg-white p-5 rounded-4 shadow-sm">
                    <h4 class="fw-bold mb-2">Send Us a Message</h4>
                    <p class="text-muted small mb-4">We'll get back to you within 24 hours.</p>

                    <!-- Success/Error Messages -->
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-controller="Home" asp-action="Contact" method="post" class="contact-form">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label fw-semibold">
                                        <i class="fas fa-user text-primary me-2"></i>Your Name
                                    </label>
                                    <input type="text" name="Name" class="form-control form-control-lg"
                                           placeholder="Enter your full name" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label fw-semibold">
                                        <i class="fas fa-envelope text-primary me-2"></i>Your Email
                                    </label>
                                    <input type="email" name="Email" class="form-control form-control-lg"
                                           placeholder="Enter your email" required />
                                </div>
                            </div>
                        </div>

                        <div class="form-group mt-3">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-tag text-primary me-2"></i>Subject
                            </label>
                            <input type="text" name="Subject" class="form-control form-control-lg"
                                   placeholder="How can we help you?" required />
                        </div>

                        <div class="form-group mt-3">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-comment text-primary me-2"></i>Message
                            </label>
                            <textarea name="Message" class="form-control" rows="5"
                                      placeholder="Write your message here..." required></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 mt-4 rounded-pill" id="submitBtn">
                            <i class="fas fa-paper-plane me-2"></i>Send Message
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Google Map -->
        <div class="row mt-5">
            <div class="col-12">
                <div class="map-container rounded-4 overflow-hidden shadow-sm">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d28959.578346889755!2d67.0011!3d24.8607!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3eb33e066f5f48dd%3A0xb2a6f2d5c72c8f9d!2sKarachi%2C%20Pakistan!5e0!3m2!1sen!2s!4v1680000000000"
                            width="100%"
                            height="350"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Contact Section End -->
<!-- Back to Top -->
<a href="#" class="btn btn-secondary px-2 back-to-top"><i class="fa fa-angle-double-up"></i></a>

@section Scripts {
    <script>
        // ===== SOCIAL MEDIA HOVER =====
        document.querySelectorAll('.social-link').forEach(link => {
            link.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-3px)';
                this.style.boxShadow = '0 5px 20px rgba(212, 175, 55, 0.3)';
            });

            link.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0)';
                this.style.boxShadow = 'none';
            });
        });

        // ===== BACK TO TOP =====
        const backToTop = document.querySelector('.back-to-top');
        if (backToTop) {
            window.addEventListener('scroll', () => {
                if (window.pageYOffset > 300) {
                    backToTop.classList.add('show');
                } else {
                    backToTop.classList.remove('show');
                }
            });

            backToTop.addEventListener('click', (e) => {
                e.preventDefault();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        }
    </script>
}