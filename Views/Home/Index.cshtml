<!-- Video modal (Bootstrap 5) -->
<div class="modal fade" id="videoModal" tabindex="-1" aria-labelledby="videoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title" id="videoModalLabel">Inside iCREAM</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="ratio ratio-16x9">
                    <iframe id="video" src="" title="iCREAM story" allow="autoplay; encrypted-media" allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Lightweight video modal wiring
        document.addEventListener('DOMContentLoaded', function () {
            var modal = document.getElementById('videoModal');
            if (!modal) return;
            var iframe = document.getElementById('video');
            var src = '';

            document.querySelectorAll('.btn-play').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    src = btn.getAttribute('data-src') || '';
                });
            });

            modal.addEventListener('shown.bs.modal', function () {
                if (src) iframe.src = src + '?autoplay=1&rel=0';
            });

            modal.addEventListener('hide.bs.modal', function () {
                iframe.src = '';
            });
        });
    </script>
}
