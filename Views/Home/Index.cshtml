@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Home";
    var products = ViewBag.Products as List<Ice_Cream_Parlour_Eproject.Models.Recipe>;
}

<!-- ============================================================
     HERO
     ============================================================ -->
<section class="hero-premium">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 hero-copy" data-aos="fade-up">
                <span class="eyebrow">Handcrafted since 2006</span>
                <h1 class="display-hero mt-3 mb-0">
                    Ice cream that tastes like <span class="text-gradient">pure joy</span>.
                </h1>
                <p class="lead-muted">
                    Small-batch artisan ice cream churned daily with organic milk, real fruit and
                    zero artificial flavourings. Discover flavours worth queuing for.
                </p>

                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Home" asp-action="Product" class="btn btn-primary btn-lg">
                        <i class="fas fa-ice-cream me-2"></i>Explore flavours
                    </a>
                    <a asp-controller="Recipe" asp-action="Index" class="btn btn-outline-secondary btn-lg">
                        <i class="fas fa-book-open me-2"></i>Browse recipes
                    </a>
                </div>

                <div class="hero-stat">
                    <div><strong>20+</strong><span>Signature flavours</span></div>
                    <div><strong>18 yrs</strong><span>Family craft</span></div>
                    <div><strong>4.9/5</strong><span>Customer rating</span></div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="hero-visual" data-aos="zoom-in" data-aos-delay="120">
                    <div class="hero-blob"></div>
                    <img class="hero-photo" src="~/img/carousel-1.jpg" alt="Freshly churned artisan ice cream" loading="eager" />
                    <div class="float-chip one"><i class="fas fa-leaf text-success"></i> 100% organic milk</div>
                    <div class="float-chip two"><i class="fas fa-star text-warning"></i> 4.9 from 2,400+ reviews</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============================================================
     TRUST STRIP
     ============================================================ -->
<section class="py-4" style="background:#fff;border-bottom:1px solid var(--line)">
    <div class="container">
        <div class="row g-3 text-center">
            <div class="col-6 col-md-3">
                <div class="d-flex align-items-center justify-content-center gap-2">
                    <i class="fas fa-truck-fast text-primary"></i>
                    <span class="small fw-semibold">Same-day delivery</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="d-flex align-items-center justify-content-center gap-2">
                    <i class="fas fa-seedling text-success"></i>
                    <span class="small fw-semibold">Organic ingredients</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="d-flex align-items-center justify-content-center gap-2">
                    <i class="fas fa-award text-warning"></i>
                    <span class="small fw-semibold">Award-winning recipes</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="d-flex align-items-center justify-content-center gap-2">
                    <i class="fas fa-shield-heart text-danger"></i>
                    <span class="small fw-semibold">No artificial additives</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============================================================
     ABOUT
     ============================================================ -->
<section class="py-5" style="padding-top:4.5rem !important;padding-bottom:4.5rem !important;">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6" data-aos="fade-right">
                <div class="position-relative">
                    <img src="~/img/about.jpg" alt="Our parlour kitchen" class="w-100 rounded-xl shadow-strong" style="aspect-ratio:4/3;object-fit:cover;" loading="lazy" />
                    <div class="glass-panel position-absolute d-none d-sm-flex align-items-center gap-3 p-3" style="bottom:-22px;right:-6px;">
                        <div class="stat-icon"><i class="fas fa-heart"></i></div>
                        <div>
                            <div class="fw-bold">Made daily</div>
                            <div class="small text-muted">Never from a tub</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6" data-aos="fade-left">
                <span class="eyebrow">Our story</span>
                <h2 class="mt-3 mb-3">A family parlour that never cut corners</h2>
                <p class="lead-muted mb-4">
                    What started as a single counter in 2006 is now a much-loved local institution.
                    Every batch still starts with fresh organic milk, real vanilla pods and fruit
                    picked at peak ripeness.
                </p>

                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="d-flex gap-3 p-3 surface-card h-100">
                            <i class="fas fa-cow text-primary fs-4"></i>
                            <div>
                                <div class="fw-bold small">Farm-to-counter</div>
                                <div class="small text-muted">Milk sourced within 40 km</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex gap-3 p-3 surface-card h-100">
                            <i class="fas fa-mortar-pestle text-primary fs-4"></i>
                            <div>
                                <div class="fw-bold small">Small batch</div>
                                <div class="small text-muted">Churned 20 L at a time</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex gap-3 p-3 surface-card h-100">
                            <i class="fas fa-leaf text-primary fs-4"></i>
                            <div>
                                <div class="fw-bold small">Clean label</div>
                                <div class="small text-muted">No gums or stabilisers</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex gap-3 p-3 surface-card h-100">
                            <i class="fas fa-users text-primary fs-4"></i>
                            <div>
                                <div class="fw-bold small">Family run</div>
                                <div class="small text-muted">Three generations</div>
                            </div>
                        </div>
                    </div>
                </div>

                <a asp-controller="Home" asp-action="About" class="btn btn-primary mt-4">
                    Read our story <i class="fas fa-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- ============================================================
     SIGNATURE FLAVOURS
     ============================================================ -->
<section class="py-5 bg-cream" style="padding-top:4.5rem !important;padding-bottom:4.5rem !important;">
    <div class="container">
        <div class="section-title" data-aos="fade-up">
            <span class="eyebrow justify-content-center">The menu</span>
            <h2 class="mt-2">Flavours our regulars swear by</h2>
            <p>Churned in-house every morning. Availability changes with the season.</p>
        </div>

        @if (products != null && products.Any())
        {
            <div class="row g-4">
                @foreach (var product in products.Take(8))
                {
                    var image = string.IsNullOrEmpty(product.ImagePath) ? Url.Content("~/img/product-1.jpg") : Url.Content(product.ImagePath);
                    <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="@(20 * (product.Id % 4))">
                        <div class="product-card h-100 d-flex flex-column">
                            <div class="product-image ratio ratio-1x1">
                                <span class="product-badge">@(product.IsFree ? "Free recipe" : "Premium")</span>
                                <img src="@image" alt="@product.Name" loading="lazy" />
                            </div>
                            <div class="product-body d-flex flex-column flex-grow-1">
                                <h5 class="product-title">@product.Name</h5>
                                <p class="product-description small text-muted mb-2">@product.Category</p>
                                <div class="product-price mt-auto">
                                    <span class="current-price">$@product.Price.ToString("0.00")</span>
                                </div>
                                <a asp-controller="Recipe" asp-action="Details" asp-route-id="@product.Id" class="btn-order">
                                    View recipe <i class="fas fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var flavour in new[] {
                    new { Name = "Madagascar Vanilla", Image = "product-1.jpg", Note = "Classic", Price = "3.99" },
                    new { Name = "Belgian Chocolate", Image = "product-2.jpg", Note = "Premium", Price = "4.99" },
                    new { Name = "Strawberry Fields", Image = "product-3.jpg", Note = "Seasonal", Price = "4.49" },
                    new { Name = "Mango Sorbet", Image = "product-4.jpg", Note = "Dairy free", Price = "3.49" },
                    new { Name = "Salted Butterscotch", Image = "product-5.jpg", Note = "Bestseller", Price = "4.49" },
                    new { Name = "Espresso Crunch", Image = "product-6.jpg", Note = "Premium", Price = "4.99" },
                    new { Name = "Pistachio Gelato", Image = "product-8.jpg", Note = "Sicilian", Price = "5.49" },
                    new { Name = "Blackcurrant Swirl", Image = "product-11.png", Note = "Seasonal", Price = "4.49" }
                })
                {
                    <div class="col-lg-3 col-md-6" data-aos="fade-up">
                        <div class="product-card h-100 d-flex flex-column">
                            <div class="product-image ratio ratio-1x1">
                                <span class="product-badge">@flavour.Note</span>
                                <img src="~/img/@flavour.Image" alt="@flavour.Name" loading="lazy" />
                            </div>
                            <div class="product-body d-flex flex-column flex-grow-1">
                                <h5 class="product-title">@flavour.Name</h5>
                                <div class="product-price mt-auto">
                                    <span class="current-price">$@flavour.Price</span>
                                </div>
                                <a asp-controller="Home" asp-action="Contact" class="btn-order">
                                    Order a tub <i class="fas fa-shopping-bag"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="text-center mt-5">
            <a asp-controller="Home" asp-action="Product" class="btn btn-outline-primary btn-lg">
                See the full menu <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
</section>

<!-- ============================================================
     MEMBERSHIP / PROMO
     ============================================================ -->
