<!-- ===== PORTFOLIO ===== -->
<div class="container-fluid my-5 py-5 px-0">
    <div class="row justify-content-center m-0">
        <div class="col-lg-5 text-center">
            <h2 class="section-title position-relative mb-5">Delicious Ice Cream Made From Our Very Own Organic Milk</h2>
        </div>
    </div>
    <div class="row m-0 portfolio-container">
        @for (int i = 1; i <= 6; i++)
        {
            <div class="col-lg-4 col-md-6 p-0 portfolio-item">
                <div class="position-relative overflow-hidden">
                    <img class="img-fluid w-100" src="~/img/portfolio-@(i).jpg" alt="">
                    <a class="portfolio-btn" href="~/img/portfolio-@(i).jpg" data-lightbox="portfolio">
                        <i class="fa fa-plus text-primary" style="font-size:60px;"></i>
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<!-- ===== PRODUCTS WITH ORDER LINKS ===== -->
<section class="container-fluid py-5">
    <div class="container">
        <div class="section-title text-center mb-5">
            <h2>Best Prices We Offer For Ice Cream Lovers</h2>
            <p>Delicious ice cream made with love and care</p>
        </div>
        <div class="row g-4">
            @if (ViewBag.Products != null)
            {
                foreach (var product in ViewBag.Products as List<Ice_Cream_Parlour_Eproject.Models.Recipe>)
                {
                    <div class="col-lg-3 col-md-6">
                        <div class="product-card">
                            <div class="product-badge">@(product.IsFree ? "Free" : "Premium")</div>
                            <div class="product-image">
                                <img src="@(string.IsNullOrEmpty(product.ImagePath) ? "~/img/product-placeholder.jpg" : product.ImagePath)" alt="@product.Name">
                            </div>
                            <div class="product-body">
                                <h5 class="product-title">@product.Name</h5>
                                <p class="product-description small text-muted">@product.Category</p>
                                <div class="product-price">
                                    <span class="current-price">$@product.Price.ToString("0.00")</span>
                                </div>
                                <a asp-controller="Book" asp-action="Order" asp-route-id="@product.Id" class="btn-order">Order Now <i class="fas fa-shopping-cart"></i></a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <!-- Fallback static products -->
                @foreach (var p in new[] { "Vanilla", "Chocolate", "Strawberry", "Mango", "Butterscotch", "Coffee", "Pistachio", "Black Currant" })
                {
                    <div class="col-lg-3 col-md-6">
                        <div class="product-card">
                            <div class="product-badge">Popular</div>
                            <div class="product-image">
                                <img src="~/img/product-@(Array.IndexOf(new[] { "Vanilla", "Chocolate", "Strawberry", "Mango", "Butterscotch", "Coffee", "Pistachio", "Black Currant" }, p) + 1).jpg" alt="@p">
                            </div>
                            <div class="product-body">
                                <h5 class="product-title">@p Ice Cream</h5>
                                <p class="product-description small text-muted">Delicious @p flavor</p>
                                <div class="product-price">
                                    <span class="current-price">$10.00</span>
                                    <span class="old-price">$15.00</span>
                                </div>
                                <a asp-controller="Book" asp-action="Order"  class="btn-order">Order Now <i class="fas fa-shopping-cart"></i></a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

