@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Book Order - iCREAM";
}

<style>
    .book-order-section {
        background: linear-gradient(135deg, #f8f9fa 0%, #fff 100%);
        padding: 60px 0;
    }

    .book-order-card {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 5px 30px rgba(0, 0, 0, 0.08);
        border: 1px solid rgba(241, 149, 178, 0.06);
        overflow: hidden;
    }

    .book-order-image {
        height: 250px;
        background: linear-gradient(135deg, #F195B2, #62C3E7);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .book-order-image i {
        font-size: 6rem;
        color: rgba(255, 255, 255, 0.3);
    }

    .book-order-form {
        padding: 40px;
    }

    .form-control:focus {
        border-color: #F195B2;
        box-shadow: 0 0 0 4px rgba(241, 149, 178, 0.1);
    }

    .submit-btn {
        background: linear-gradient(135deg, #F195B2, #62C3E7);
        color: #fff;
        border: none;
        padding: 14px 30px;
        border-radius: 50px;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .submit-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(241, 149, 178, 0.3);
    }

    .breadcrumb-custom a {
        color: #666;
        text-decoration: none;
    }

    .breadcrumb-custom a:hover {
        color: #F195B2;
    }

    .breadcrumb-custom .active {
        color: #F195B2;
    }
</style>

<!-- Page Header -->
<div style="background: linear-gradient(135deg, #F195B2, #62C3E7); min-height: 200px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; color: white; border-radius: 0 0 30px 30px; padding: 30px 20px;">
    <h1 style="font-size: 2.2rem; font-weight: 700; margin-bottom: 6px;"><i class="fas fa-shopping-cart me-3"></i> Book Your Order</h1>
    <p style="font-size: 1rem; opacity: 0.9; max-width: 500px;">Reserve your delicious ice cream order now</p>
</div>

<!-- Order Form Section -->
<div class="book-order-section">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="book-order-card">
                    <div class="book-order-image">
                        <i class="fas fa-ice-cream"></i>
                    </div>
                    <div class="book-order-form">
                        <div class="text-center mb-4">
                            <h3 class="fw-bold" style="font-family: 'Playfair Display', serif;">Special Order Request</h3>
                            <p class="text-muted">Fill in the form below and we'll get back to you shortly</p>
                        </div>

                        <!-- Success/Error Messages -->
                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }
                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }

                        <form asp-controller="Book" asp-action="Order" method="post">
                            @Html.AntiForgeryToken()

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">
                                        <i class="fas fa-user text-primary me-2"></i>Your Name <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" name="CustomerName" class="form-control" placeholder="Enter your full name" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">
                                        <i class="fas fa-envelope text-primary me-2"></i>Email Address <span class="text-danger">*</span>
                                    </label>
                                    <input type="email" name="CustomerEmail" class="form-control" placeholder="Enter your email" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">
                                        <i class="fas fa-phone-alt text-primary me-2"></i>Phone Number <span class="text-danger">*</span>
                                    </label>
                                    <input type="tel" name="CustomerPhone" class="form-control" placeholder="Enter your phone number" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">
                                        <i class="fas fa-tag text-primary me-2"></i>Preferred Flavor <span class="text-danger">*</span>
                                    </label>
                                    <select name="SelectedFlavor" class="form-select" required>
                                        <option value="">Select a flavor</option>
                                        <option value="Vanilla">Vanilla Dream</option>
                                        <option value="Chocolate">Chocolate Fudge</option>
                                        <option value="Strawberry">Strawberry Bliss</option>
                                        <option value="Mango">Mango Tango</option>
                                        <option value="Butterscotch">Butterscotch</option>
                                        <option value="Pistachio">Pistachio Delight</option>
                                        <option value="Mint">Mint Chip</option>
                                        <option value="Cookies">Cookies & Cream</option>
                                        <option value="Custom">Custom Request</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">
                                        <i class="fas fa-calendar-alt text-primary me-2"></i>Preferred Date <span class="text-danger">*</span>
                                    </label>
                                    <input type="date" name="OrderDate" class="form-control" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">
                                        <i class="fas fa-sort-amount-down text-primary me-2"></i>Quantity <span class="text-danger">*</span>
                                    </label>
                                    <input type="number" name="Quantity" class="form-control" min="1" value="1" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">
                                        <i class="fas fa-money-bill-wave text-primary me-2"></i>Payment Method <span class="text-danger">*</span>
                                    </label>
                                    <select name="PaymentType" class="form-select" required>
                                        <option value="">Select payment method</option>
                                        <option value="Cash on Delivery">Cash on Delivery</option>
                                        <option value="Credit Card">Credit Card</option>
                                        <option value="Debit Card">Debit Card</option>
                                        <option value="Online Transfer">Online Transfer</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">
                                        <i class="fas fa-user-clock text-primary me-2"></i>Delivery Time <span class="text-danger">*</span>
                                    </label>
                                    <select name="DeliveryTime" class="form-select" required>
                                        <option value="">Select time slot</option>
                                        <option value="Morning (9AM - 12PM)">Morning (9AM - 12PM)</option>
                                        <option value="Afternoon (12PM - 4PM)">Afternoon (12PM - 4PM)</option>
                                        <option value="Evening (4PM - 7PM)">Evening (4PM - 7PM)</option>
                                        <option value="Night (7PM - 10PM)">Night (7PM - 10PM)</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-semibold">
                                        <i class="fas fa-map-marker-alt text-primary me-2"></i>Delivery Address <span class="text-danger">*</span>
                                    </label>
                                    <textarea name="DeliveryAddress" class="form-control" rows="3" placeholder="Enter your full delivery address" required></textarea>
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-semibold">
                                        <i class="fas fa-comment text-primary me-2"></i>Special Instructions
                                    </label>
                                    <textarea name="SpecialInstructions" class="form-control" rows="2" placeholder="Any special requests or allergies..."></textarea>
                                </div>
                            </div>

                            <div class="text-center mt-4">
                                <button type="submit" class="submit-btn">
                                    <i class="fas fa-paper-plane me-2"></i> Place Order
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Back to Top -->
<a href="#" style="position: fixed; bottom: 30px; right: 30px; width: 44px; height: 44px; background: linear-gradient(135deg, #F195B2, #62C3E7); color: #fff; border: none; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 18px; box-shadow: 0 6px 20px rgba(241, 149, 178, 0.4); text-decoration: none; z-index: 999; transition: 0.3s;">
    <i class="fa fa-angle-double-up"></i>
</a>