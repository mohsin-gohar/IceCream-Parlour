@model ErrorViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    int? statusCode = ViewBag.StatusCode as int?;
    ViewData["Title"] = statusCode == 404 ? "Page Not Found - iCREAM" : "Error - iCREAM";
}

<div style="padding: 60px 20px; text-align: center; max-width: 600px; margin: 0 auto;">
    @if (statusCode == 404)
    {
        <div style="font-size: 5rem; color: #F195B2; font-weight: 800; line-height: 1;">404</div>
        <h2 style="font-weight: 700; margin-top: 15px; color: #333;">Oops! Page Not Found</h2>
        <p style="color: #666; margin-bottom: 25px;">The page or recipe you are looking for does not exist or has been moved.</p>
        <a href="@Url.Action("Index", "Home")" style="background: linear-gradient(135deg, #F195B2, #62C3E7); color: #fff; padding: 12px 30px; border-radius: 50px; text-decoration: none; font-weight: 700;">Back to Home</a>
    }
    else
    {
        <div style="font-size: 5rem; color: #dc3545; font-weight: 800; line-height: 1;">500</div>
        <h2 style="font-weight: 700; margin-top: 15px; color: #333;">An Error Occurred</h2>
        <p style="color: #666; margin-bottom: 20px;">An unexpected error occurred while processing your request. Please try again later.</p>
        @if (Model.ShowRequestId)
        {
            <p style="font-size: 0.85rem; color: #888;">
                <strong>Request ID:</strong> <code>@Model.RequestId</code>
            </p>
        }
        <a href="@Url.Action("Index", "Home")" style="background: linear-gradient(135deg, #F195B2, #62C3E7); color: #fff; padding: 12px 30px; border-radius: 50px; text-decoration: none; font-weight: 700; display: inline-block; margin-top: 15px;">Back to Home</a>
    }
</div>
