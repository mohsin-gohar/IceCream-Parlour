                    </ul>
                    <div style="margin-top: 16px;">
                        <p style="color: rgba(255,255,255,0.4); font-size: 0.8rem; margin-bottom: 6px;">Subscribe to our newsletter</p>
                        <div style="display: flex; gap: 6px;">
                            <input type="email" placeholder="Your email" style="flex:1; padding: 6px 12px; border: none; border-radius: 30px; background: rgba(255,255,255,0.08); color: #fff; font-size: 0.8rem; outline: none; transition: 0.3s;" onfocus="this.style.background='rgba(255,255,255,0.15)';" onblur="this.style.background='rgba(255,255,255,0.08)';" />
                            <button style="background: linear-gradient(135deg, #F195B2, #62C3E7); border: none; border-radius: 30px; padding: 6px 16px; color: #fff; font-weight: 600; font-size: 0.75rem; cursor: pointer; transition: 0.3s;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px rgba(241,149,178,0.3)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">Subscribe</button>
                        </div>
                    </div><br />
                    @* <div style="display: flex; gap: 6px;">
                        <button style="background: linear-gradient(135deg, #F195B2, #62C3E7); border: none; border-radius: 30px; padding: 6px 16px; color: #fff; font-weight: 600; font-size: 0.75rem; cursor: pointer; transition: 0.3s;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px rgba(241,149,178,0.3)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">Register</button>
                        <button style="background: linear-gradient(135deg, #F195B2, #62C3E7); border: none; border-radius: 30px; padding: 6px 16px; color: #fff; font-weight: 600; font-size: 0.75rem; cursor: pointer; transition: 0.3s;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px rgba(241,149,178,0.3)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">Login</button>
                    </div>  *@
                    <div style="display: flex; gap: 10px; margin-top: 8px;">
                        <!-- Register Button -->
                        <a asp-controller="Account" asp-action="Register"
                           style="display: inline-block; padding: 8px 24px;
                            background: linear-gradient(135deg, #F195B2, #e07a9e);
                            color: #fff; font-weight: 600; font-size: 0.85rem;
                            border: none; border-radius: 50px;
                            text-decoration: none; cursor: pointer;
                            transition: all 0.3s ease;
                            box-shadow: 0 4px 15px rgba(241,149,178,0.3);"
                           onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='0 8px 25px rgba(241,149,178,0.5)'; this.style.background='linear-gradient(135deg, #e07a9e, #d46a8e)';"
                           onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(241,149,178,0.3)'; this.style.background='linear-gradient(135deg, #F195B2, #e07a9e)';">
                            <i class="fas fa-user-plus me-2"></i>Register
                        </a>

                        <!-- Login Button -->
                        <a asp-controller="Account" asp-action="Login"
                           style="display: inline-block; padding: 8px 28px;
                            background: linear-gradient(135deg, #62C3E7, #4aafd4);
                            color: #fff; font-weight: 600; font-size: 0.85rem;
                            border: none; border-radius: 50px;
                            text-decoration: none; cursor: pointer;
                            transition: all 0.3s ease;
                            box-shadow: 0 4px 15px rgba(98,195,231,0.3);"
                           onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='0 8px 25px rgba(98,195,231,0.5)'; this.style.background='linear-gradient(135deg, #4aafd4, #3a9fc4)';"
                           onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(98,195,231,0.3)'; this.style.background='linear-gradient(135deg, #62C3E7, #4aafd4)';">
                            <i class="fas fa-sign-in-alt me-2"></i>Login
                        </a>
                    </div>
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-12 text-center">
                    <p style="color: rgba(255,255,255,0.3); font-size: 0.85rem; margin: 0;">
                        &copy; @DateTime.Now.Year <strong style="color: #F195B2;">iCREAM</strong>. All Rights Reserved.
                        <span style="margin: 0 8px;">|</span>
                        <a asp-controller="Home" asp-action="Privacy" style="color: rgba(255,255,255,0.3); text-decoration: none; transition: 0.3s;" onmouseover="this.style.color='#F195B2';" onmouseout="this.style.color='rgba(255,255,255,0.3)';">Privacy Policy</a>
                        <span style="margin: 0 8px;">|</span>
                        <a asp-controller="Home" asp-action="Faq" style="color: rgba(255,255,255,0.3); text-decoration: none; transition: 0.3s;" onmouseover="this.style.color='#F195B2';" onmouseout="this.style.color='rgba(255,255,255,0.3)';">FAQ</a>
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <!-- ===== BACK TO TOP ===== -->
    <button id="backBtn" class="btn btn-primary rounded-circle position-fixed bottom-0 end-0 m-4 shadow" style="display:none; width:45px; height:45px; background: linear-gradient(135deg, #F195B2, #62C3E7); border: none; box-shadow: 0 6px 20px rgba(241,149,178,0.4); color: #fff; transition: 0.3s;" onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='0 10px 30px rgba(241,149,178,0.5)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 6px 20px rgba(241,149,178,0.4)';">
        <i class="fas fa-arrow-up"></i>
    </button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        $(window).scroll(function() {
        if ($(this).scrollTop() > 200) $('#backBtn').fadeIn();
        else $('#backBtn').fadeOut();
        });
        $('#backBtn').click(function() { $('html,body').animate({scrollTop:0},600); });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>