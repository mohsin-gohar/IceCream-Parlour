@using System.Globalization
@using System.Security.Claims
@{
    // Values come from the authentication cookie (see AppUserClaimsPrincipalFactory) - no DB hit per request.
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var fullName = User.FindFirstValue("full_name") ?? User.Identity?.Name ?? "";
    var avatarImage = User.FindFirstValue("avatar") ?? string.Empty;
    var isPaid = string.Equals(User.FindFirstValue("is_paid"), "true", StringComparison.OrdinalIgnoreCase);

    var membershipActive = false;
    if (isAuthenticated && isPaid && DateTime.TryParse(
            User.FindFirstValue("payment_expiry"), CultureInfo.InvariantCulture,
            DateTimeStyles.RoundtripKind, out var expiry))
    {
        membershipActive = expiry > DateTime.UtcNow;
    }

    var showMembershipBanner = !membershipActive;
    var userInitials = "U";

    if (!string.IsNullOrWhiteSpace(fullName))
    {
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        userInitials = parts.Length >= 2
            ? string.Concat(parts[0][0], parts[1][0]).ToUpperInvariant()
            : parts[0][0].ToString().ToUpperInvariant();
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="description" content="iCREAM - Premium Ice Cream Parlour" />
    <meta name="keywords" content="ice cream, parlor, artisan, desserts" />
    <meta property="og:title" content="@ViewData["Title"] - iCREAM" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://icream.com" />
    <meta property="og:description" content="Premium ice cream parlor offering artisan flavors, recipe books, and exclusive membership content." />
    <meta property="og:image" content="~/img/og-image.jpg" />
    <link rel="canonical" href="https://icream.com" />

    <title>@ViewData["Title"] - iCREAM</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.4/dist/aos.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/premium.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- ============================================================ -->
    <!-- ===== NAVBAR ===== -->
    <!-- ============================================================ -->
    <nav class="navbar navbar-expand-lg sticky-top px-0">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                <div style="width:42px;height:42px;background:var(--grad-rose);border-radius:12px;display:grid;place-items:center;box-shadow:var(--sh-rose)">
                    <i class="fas fa-ice-cream text-white" style="font-size:1.15rem"></i>
                </div>
                <span class="ms-2 fw-bold fs-4" style="background:var(--grad-rose);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;font-family:'Playfair Display',serif;letter-spacing:-.5px">iCREAM</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav mx-auto my-3 my-lg-0">
                    <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Product" ? "active" : "")" asp-controller="Home" asp-action="Product">Flavours</a></li>
                    <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Recipe" ? "active" : "")" asp-controller="Recipe" asp-action="Index">Recipes</a></li>
                    <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Book" ? "active" : "")" asp-controller="Book" asp-action="Index">Books</a></li>
                    <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Gallery" ? "active" : "")" asp-controller="Gallery" asp-action="Index">Gallery</a></li>
                    <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")" asp-controller="Home" asp-action="About">About</a></li>
                    <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Contact" ? "active" : "")" asp-controller="Home" asp-action="Contact">Contact</a></li>
                </ul>

                <div class="d-flex align-items-center gap-2 my-3 my-lg-0">
                    @if (isAuthenticated)
                    {
                        <div class="dropdown">
                            <button class="btn btn-light dropdown-toggle d-flex align-items-center gap-2 ps-2 pe-3" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @if (!string.IsNullOrEmpty(avatarImage))
                                {
                                    <img src="@avatarImage" alt="@fullName" class="rounded-circle" style="width:32px;height:32px;object-fit:cover" />
                                }
                                else
                                {
                                    <span class="rounded-circle d-flex align-items-center justify-content-center" style="width:32px;height:32px;background:var(--grad-rose);color:#fff;font-weight:700;font-size:.8rem">@userInitials</span>
                                }
                                <span class="d-none d-sm-inline small fw-semibold">@fullName</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="fas fa-user text-primary me-2"></i>My profile</a></li>
                                <li><a class="dropdown-item" asp-controller="Order" asp-action="MyOrders"><i class="fas fa-bag-shopping text-primary me-2"></i>My orders</a></li>
                                <li><a class="dropdown-item" asp-controller="Order" asp-action="Track"><i class="fas fa-location-dot text-primary me-2"></i>Track order</a></li>
                                @if (membershipActive)
                                {
                                    <li><span class="dropdown-item disabled text-success"><i class="fas fa-crown text-warning me-2"></i>Premium member</span></li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger"><i class="fas fa-right-from-bracket me-2"></i>Sign out</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary">Sign in</a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary">Join free</a>
                    }
                    <a asp-controller="Book" asp-action="Index" class="btn btn-outline-primary d-none d-md-inline-flex">
                        <i class="fas fa-bag-shopping me-1"></i>Shop
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- ============================================================ -->
    <!-- ===== MAIN CONTENT ===== -->
    <!-- ============================================================ -->
    <main class="flex-grow-1">
        @if (TempData["Success"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }

        @RenderBody()
    </main>

    <!-- ============================================================ -->
    <!-- ===== SMART MEMBERSHIP BANNER ===== -->
    <!-- ============================================================ -->
    @if (showMembershipBanner)
    {
        <section class="container pb-4">
            <div class="rounded-xl overflow-hidden shadow-strong p-4 p-md-4" style="background:linear-gradient(120deg,#1E2542 0%,#2A1F33 55%,#3A2338 100%)" data-aos="fade-up">
                <div class="row align-items-center g-3">
                    <div class="col-lg-8 d-flex align-items-center gap-3">
                        <div class="rounded-circle d-grid" style="width:56px;height:56px;place-items:center;background:var(--grad-rose);box-shadow:var(--sh-rose);flex:0 0 auto">
                            <i class="fas fa-crown text-white"></i>
                        </div>
                        <div>
                            <h5 class="text-white mb-1" style="font-size:1.2rem">Unlock the full recipe archive</h5>
                            <p class="mb-0 small" style="color:rgba(255,255,255,.66)">20+ artisan recipes, seasonal drops and 10% off every book.</p>
                        </div>
                    </div>
                    <div class="col-lg-4 d-flex justify-content-lg-end gap-2 mt-3 mt-lg-0">
                        <a asp-controller="Account" asp-action="Register" class="btn btn-gradient">Join for $15/mo</a>
                        <a asp-controller="Home" asp-action="Faq" class="btn btn-outline-light">Details</a>
                    </div>
                </div>
            </div>
        </section>
    }

<!-- ============================================================ -->
    <!-- ===== PROFESSIONAL FOOTER ===== -->
    <!-- ============================================================ -->
    <footer class="footer">
        <div class="container py-5">
            <div class="row g-4 pb-4">
                <div class="col-lg-4 col-md-6">
                    <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center text-decoration-none mb-3">
                        <div style="width:42px;height:42px;background:var(--grad-rose);border-radius:12px;display:grid;place-items:center;box-shadow:var(--sh-rose)">
                            <i class="fas fa-ice-cream text-white"></i>
                        </div>
                        <span class="ms-2 fw-bold fs-4" style="color:#fff;font-family:'Playfair Display',serif">iCREAM</span>
                    </a>
                    <p style="max-width:320px">
                        Artisan ice cream churned in small batches since 2006. Organic milk, real fruit and no shortcuts.
                    </p>
                    <div class="d-flex gap-2 mt-3">
                        <a href="#" class="footer-social" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="footer-social" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="footer-social" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="footer-social" aria-label="TikTok"><i class="fab fa-tiktok"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h6>Explore</h6>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Home" asp-action="Product">Flavours</a></li>
                        <li><a asp-controller="Recipe" asp-action="Index">Recipes</a></li>
                        <li><a asp-controller="Book" asp-action="Index">Recipe books</a></li>
                        <li><a asp-controller="Gallery" asp-action="Index">Gallery</a></li>
                        <li><a asp-controller="Home" asp-action="About">Our story</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h6>Account</h6>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Account" asp-action="Login">Sign in</a></li>
                        <li><a asp-controller="Account" asp-action="Register">Create account</a></li>
                        <li><a asp-controller="Account" asp-action="Profile">My profile</a></li>
                        <li><a asp-controller="Order" asp-action="MyOrders">My orders</a></li>
                        <li><a asp-controller="Order" asp-action="Track">Track order</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-6">
                    <h6>Stay in the loop</h6>
                    <p class="mb-3">New flavour drops, member offers and kitchen notes. No spam, ever.</p>
                    <form id="newsletterForm" class="d-flex gap-2">
                        <input type="email" class="form-control" placeholder="you@example.com" aria-label="Email address" required />
                        <button type="submit" class="btn btn-primary" style="white-space:nowrap">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </form>
                    <div class="d-flex flex-column gap-2 mt-4 small">
                        <span><i class="fas fa-location-dot me-2"></i>123 Ice Cream Street, Karachi</span>
                        <span><i class="fas fa-phone me-2"></i>+92 300 1234567</span>
                        <span><i class="fas fa-envelope me-2"></i>support@icream.com</span>
                    </div>
                </div>
            </div>

            <hr style="border-color:rgba(255,255,255,.1)" />

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 pt-2">
                <span class="small">&copy; @DateTime.Now.Year iCREAM. All rights reserved.</span>
                <div class="d-flex gap-3 small">
                    <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                    <a asp-controller="Home" asp-action="Faq">Terms &amp; FAQ</a>
                    <a asp-controller="Home" asp-action="Contact">Contact</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- ===== BACK TO TOP ===== -->
    <button id="backBtn" class="btn btn-primary rounded-circle position-fixed bottom-0 end-0 m-4 shadow" style="display:none; width:45px; height:45px; background: linear-gradient(135deg, #F195B2, #62C3E7); border: none; box-shadow: 0 6px 20px rgba(241,149,178,0.4); color: #fff; transition: 0.3s;" onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='0 10px 30px rgba(241,149,178,0.5)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 6px 20px rgba(241,149,178,0.4)';">
        <i class="fas fa-arrow-up"></i>
    </button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // AOS is optional - never break the page if the CDN is unreachable.
        if (window.AOS) {
            AOS.init({ duration: 700, once: true, offset: 80, easing: 'ease-out-cubic' });
        }
    </script>
    <script>
        $(window).scroll(function() {
        if ($(this).scrollTop() > 200) $('#backBtn').fadeIn();
        else $('#backBtn').fadeOut();
        });
        $('#backBtn').click(function() { $('html,body').animate({scrollTop:0},600); });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>