@model Ice_Cream_Parlour_Eproject.Areas.Models.Order
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Track Order";
    var status = Model?.OrderStatus?.ToLowerInvariant() ?? "pending";
    var step1 = Model != null;
    var step2 = status is "processing" or "shipped" or "out for delivery" or "completed" or "delivered";
    var step3 = status is "shipped" or "out for delivery" or "completed" or "delivered";
    var step4 = status is "completed" or "delivered";
    var paymentClass = Model?.PaymentStatus switch
    {
        "Paid" => "badge-paid",
        "Failed" => "badge-failed",
        "Refunded" => "badge-refunded",
        _ => "badge-pending"
    };
}

<section class="page-header-premium">
    <div class="container">
        <h1>Track your order</h1>
        <p>Enter your order number and the e-mail used at checkout.</p>
        <div class="breadcrumb-chip">
            <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Home</a>
            <i class="fas fa-chevron-right" style="font-size:.6rem;opacity:.7"></i>
            <span>Track order</span>
        </div>
    </div>
</section>

<section class="py-5" style="padding-top:3.5rem !important;padding-bottom:4.5rem !important;">
    <div class="container" style="max-width:900px">

        <!-- Search -->
        <div class="surface-card p-4 mb-4" data-aos="fade-up">
            <form asp-controller="Order" asp-action="Track" method="get" class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="form-label" for="orderNumber">Order number</label>
                    <input id="orderNumber" type="text" name="orderNumber" class="form-control"
                           placeholder="ORD-20261022-ABCD1234" maxlength="50"
                           value="@Context.Request.Query["orderNumber"]" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="email">E-mail used for the order</label>
                    <input id="email" type="email" name="email" class="form-control"
                           placeholder="you@example.com" maxlength="100"
                           value="@Context.Request.Query["email"]" />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100"><i class="fas fa-magnifying-glass me-1"></i>Track</button>
                </div>
                <div class="col-12">
                    <div class="form-text"><i class="fas fa-lock me-1"></i>For your privacy, sign in or provide the e-mail used when ordering.</div>
                </div>
            </form>
        </div>

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-warning d-flex align-items-start gap-2" data-aos="fade-up">
                <i class="fas fa-triangle-exclamation mt-1"></i>
                <div>@ViewBag.Message</div>
            </div>
        }

        @if (Model != null)
        {
            <div class="surface-card p-4 p-md-5" data-aos="fade-up">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 pb-3 mb-4" style="border-bottom:1px solid var(--line)">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h4 class="fw-bold mb-0" style="font-family:'Inter',sans-serif;font-size:1.15rem">@Model.OrderNumber</h4>
                            <span class="badge-status badge-@status">@Model.OrderStatus</span>
                        </div>
                        <div class="small text-muted"><i class="fas fa-calendar me-1"></i>Placed @Model.OrderDate.ToString("dd MMMM yyyy · HH:mm")</div>
                    </div>
                    <div class="text-end">
                        <div class="small text-muted">Order total</div>
                        <div class="fw-bold" style="font-size:1.3rem;color:var(--rose-ink)">$@Model.TotalAmount.ToString("0.00")</div>
                    </div>
                </div>

                <!-- Timeline -->
                <div class="timeline-steps my-4">
                    <div class="timeline-step @(step1 ? (step2 ? "completed" : "active") : "")">
                        <div class="timeline-icon"><i class="fas fa-receipt"></i></div>
                        <div class="timeline-title">Placed</div>
                    </div>
                    <div class="timeline-step @(step2 ? (step3 ? "completed" : "active") : "")">
                        <div class="timeline-icon"><i class="fas fa-ice-cream"></i></div>
                        <div class="timeline-title">Preparing</div>
                    </div>
                    <div class="timeline-step @(step3 ? (step4 ? "completed" : "active") : "")">
                        <div class="timeline-icon"><i class="fas fa-truck"></i></div>
                        <div class="timeline-title">On the way</div>
                    </div>
                    <div class="timeline-step @(step4 ? "completed" : "")">
                        <div class="timeline-icon"><i class="fas fa-house"></i></div>
                        <div class="timeline-title">Delivered</div>
                    </div>
                </div>

                <!-- Details -->
                <div class="row g-3 mt-4">
                    <div class="col-md-6">
                        <div class="surface-card p-3 h-100">
                            <div class="small text-muted mb-1">Customer</div>
                            <div class="fw-semibold">@Model.CustomerName</div>
                            <div class="small text-muted">@Model.CustomerEmail</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="surface-card p-3 h-100">
                            <div class="small text-muted mb-1">Payment</div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge-status @paymentClass">@Model.PaymentStatus</span>
                                <span class="small text-muted">@Model.PaymentMethod</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="surface-card p-3">
                            <div class="small text-muted mb-1">Delivery address</div>
                            <div class="fw-semibold">@(string.IsNullOrEmpty(Model.DeliveryAddress) ? "Store pickup" : Model.DeliveryAddress)</div>
                        </div>
                    </div>
                    @if (Model.Book != null)
                    {
                        <div class="col-12">
                            <div class="surface-card p-3 d-flex align-items-center gap-3">
                                @if (!string.IsNullOrEmpty(Model.Book.ImagePath))
                                {
                                    <img src="@Url.Content(Model.Book.ImagePath)" alt="@Model.Book.Title" class="rounded-md" style="width:48px;height:64px;object-fit:cover" />
                                }
                                <div>
                                    <div class="fw-semibold small">@Model.Book.Title</div>
                                    <div class="small text-muted">@Model.Book.Author</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <a asp-controller="Order" asp-action="MyOrders" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>My orders</a>
                    <a asp-controller="Home" asp-action="Contact" class="btn btn-primary"><i class="fas fa-headset me-2"></i>Need help?</a>
                </div>
            </div>
        }
    </div>
</section>
