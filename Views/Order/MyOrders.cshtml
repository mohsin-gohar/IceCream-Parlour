@model IEnumerable<Ice_Cream_Parlour_Eproject.Areas.Models.Order>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Orders";
    var orders = Model?.ToList() ?? new List<Ice_Cream_Parlour_Eproject.Areas.Models.Order>();
}

<section class="page-header-premium">
    <div class="container">
        <h1>My orders</h1>
        <p>Every scoop, book and gift you have ordered from us.</p>
        <div class="breadcrumb-chip">
            <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Home</a>
            <i class="fas fa-chevron-right" style="font-size:.6rem;opacity:.7"></i>
            <span>My orders</span>
        </div>
    </div>
</section>

<section class="py-5" style="padding-top:3.5rem !important;padding-bottom:4.5rem !important;">
    <div class="container" style="max-width:1000px">
        @if (orders.Count == 0)
        {
            <div class="text-center surface-card p-5" data-aos="fade-up">
                <div class="stat-icon mx-auto mb-3" style="width:64px;height:64px;font-size:1.4rem"><i class="fas fa-bag-shopping"></i></div>
                <h4 class="fw-bold">No orders yet</h4>
                <p class="text-muted mb-4">When you order a recipe book it will appear here with live tracking.</p>
                <a asp-controller="Book" asp-action="Index" class="btn btn-primary">Browse recipe books</a>
            </div>
        }
        else
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="small text-muted">@orders.Count order@(orders.Count == 1 ? "" : "s")</span>
                <a asp-controller="Order" asp-action="Track" class="small fw-semibold text-decoration-none">Track a different order</a>
            </div>

            <div class="d-flex flex-column gap-3">
                @foreach (var order in orders)
                {
                    var statusClass = (order.OrderStatus ?? "pending").ToLower();
                    <div class="surface-card p-4" data-aos="fade-up">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <h5 class="fw-bold mb-0" style="font-family:'Inter',sans-serif;font-size:1rem">@order.OrderNumber</h5>
                                    <span class="badge-status badge-@statusClass">@order.OrderStatus</span>
                                </div>
                                <div class="small text-muted"><i class="fas fa-calendar me-1"></i>@order.OrderDate.ToString("dd MMM yyyy · HH:mm")</div>
                            </div>
                            <div class="text-end">
                                <div class="small text-muted">Total</div>
                                <div class="fw-bold" style="font-size:1.2rem;color:var(--rose-ink)">$@order.TotalAmount.ToString("0.00")</div>
                            </div>
                        </div>

                        <hr class="divider-soft my-3" />

                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                            <div class="d-flex align-items-center gap-3">
                                @if (order.Book != null)
                                {
                                    @if (!string.IsNullOrEmpty(order.Book.ImagePath))
                                    {
                                        <img src="@Url.Content(order.Book.ImagePath)" alt="@order.Book.Title" class="rounded-md" style="width:54px;height:72px;object-fit:cover" />
                                    }
                                    <div>
                                        <div class="fw-semibold small">@order.Book.Title</div>
                                        <div class="small text-muted">@order.Book.Author</div>
                                    </div>
                                }
                                else
                                {
                                    <div class="stat-icon" style="width:42px;height:42px;font-size:.85rem"><i class="fas fa-ice-cream"></i></div>
                                    <div>
                                        <div class="fw-semibold small">iCREAM order</div>
                                        <div class="small text-muted">Payment: @order.PaymentStatus</div>
                                    </div>
                                }
                            </div>
                            <a asp-controller="Order" asp-action="Track" asp-route-orderNumber="@order.OrderNumber" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-location-dot me-1"></i>Track order
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
