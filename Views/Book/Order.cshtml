@model Ice_Cream_Parlour_Eproject.Models.Book
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Checkout";
    var cover = string.IsNullOrEmpty(Model.ImagePath) ? null : Url.Content(Model.ImagePath);
    var shipping = Model.Price >= 100 ? 0m : 4.99m;
    var total = Model.Price + shipping;
}

<section class="page-header-premium">
    <div class="container">
        <h1>Checkout</h1>
        <p>One page, no surprises. Free shipping over $100.</p>
        <div class="breadcrumb-chip">
            <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Home</a>
            <i class="fas fa-chevron-right" style="font-size:.6rem;opacity:.7"></i>
            <a asp-controller="Book" asp-action="Index">Books</a>
            <i class="fas fa-chevron-right" style="font-size:.6rem;opacity:.7"></i>
            <span>Checkout</span>
        </div>
    </div>
</section>

<section class="py-5" style="padding-top:3.5rem !important;padding-bottom:4.5rem !important;">
    <div class="container">
        <div class="row g-4 g-lg-4">
            <!-- ===== FORM ===== -->
            <div class="col-lg-7" data-aos="fade-right">
                <div class="surface-card p-4 p-lg-5">
                    <h4 class="fw-bold mb-1" style="font-family:'Playfair Display',serif">Delivery details</h4>
                    <p class="small text-muted mb-4">We only use these details to deliver your order.</p>

                    <form asp-controller="Book" asp-action="Order" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" style="display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="BookId" value="@Model.Id" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="customerName">Full name <span class="text-danger">*</span></label>
                                <input id="customerName" type="text" name="CustomerName" class="form-control" placeholder="Jane Doe" maxlength="100" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="customerEmail">Email <span class="text-danger">*</span></label>
                                <input id="customerEmail" type="email" name="CustomerEmail" class="form-control" placeholder="jane@example.com" maxlength="100" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="customerPhone">Phone <span class="text-danger">*</span></label>
                                <input id="customerPhone" type="tel" name="CustomerPhone" class="form-control" placeholder="+92 300 1234567" maxlength="20" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="paymentMethod">Payment method <span class="text-danger">*</span></label>
                                <select id="paymentMethod" name="PaymentMethod" class="form-select" required>
                                    <option value="">Choose…</option>
                                    <option value="Credit Card">Credit card</option>
                                    <option value="Debit Card">Debit card</option>
                                    <option value="PayPal">PayPal</option>
                                    <option value="Cash on Delivery">Cash on delivery</option>
                                    <option value="Bank Transfer">Bank transfer</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="deliveryAddress">Delivery address <span class="text-danger">*</span></label>
                                <textarea id="deliveryAddress" name="DeliveryAddress" class="form-control" rows="3" placeholder="Street, city, postal code" maxlength="255" required></textarea>
                            </div>
                        </div>

                        <div class="d-flex align-items-start gap-2 mt-4 p-3 rounded-md" style="background:#F9FAFB">
                            <i class="fas fa-shield-halved text-success mt-1"></i>
                            <div class="small text-muted">Your details are used only to process and deliver this order. We never store card numbers.</div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 mt-4">
                            <i class="fas fa-lock me-2"></i>Place order · $@total.ToString("0.00")
                        </button>
                        <p class="form-text text-center mt-3 mb-0">You will receive the order number and tracking link immediately.</p>
                    </form>
                </div>
            </div>

            <!-- ===== SUMMARY ===== -->
            <div class="col-lg-5" data-aos="fade-left">
                <div class="surface-card p-4 p-lg-4" style="position:sticky;top:calc(var(--nav-h) + 1rem)">
                    <h5 class="fw-bold mb-3">Order summary</h5>

                    <div class="d-flex gap-3 pb-3" style="border-bottom:1px solid var(--line)">
                        <div class="rounded-md overflow-hidden flex-shrink-0" style="width:78px;height:104px;background:linear-gradient(160deg,#FFF3F6,#EFFAFF)">
                            @if (cover != null)
                            {
                                <img src="@cover" alt="@Model.Title" class="img-cover" />
                            }
                            else
                            {
                                <div class="d-grid h-100" style="place-items:center;color:var(--rose);opacity:.4;font-size:1.6rem"><i class="fas fa-book"></i></div>
                            }
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-bold" style="font-family:'Playfair Display',serif;font-size:1.05rem">@Model.Title</div>
                            <div class="small text-muted mb-1">@Model.Author</div>
                            <div class="small text-muted">@(Model.StockQuantity > 0 ? $"In stock · {Model.StockQuantity} left" : "Out of stock")</div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between py-2 small">
                        <span class="text-muted">Item</span>
                        <span class="fw-semibold">$@Model.Price.ToString("0.00")</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 small">
                        <span class="text-muted">Shipping</span>
                        <span class="fw-semibold">@(shipping == 0 ? "Free" : "$" + shipping.ToString("0.00"))</span>
                    </div>
                    <div class="d-flex justify-content-between py-3 mt-2" style="border-top:1px solid var(--line)">
                        <span class="fw-bold">Total</span>
                        <span class="fw-bold" style="font-size:1.25rem;color:var(--rose-ink)">$@total.ToString("0.00")</span>
                    </div>

                    <div class="d-flex flex-column gap-2 mt-3 small text-muted">
                        <span><i class="fas fa-truck-fast me-2 text-primary"></i>Dispatched within 1 business day</span>
                        <span><i class="fas fa-rotate-left me-2 text-primary"></i>14-day returns</span>
                        <span><i class="fas fa-box me-2 text-primary"></i>Rigid, recyclable packaging</span>
                    </div>

                    <a asp-controller="Book" asp-action="Index" class="btn btn-outline-secondary w-100 mt-4">
                        <i class="fas fa-arrow-left me-2"></i>Continue shopping
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
