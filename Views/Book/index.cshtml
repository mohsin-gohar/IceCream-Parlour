@model IEnumerable<Ice_Cream_Parlour_Eproject.Models.Book>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Recipe Books";
    var books = Model?.ToList() ?? new List<Ice_Cream_Parlour_Eproject.Models.Book>();
}

<!-- ===== PAGE HEADER ===== -->
<section class="page-header-premium">
    <div class="container">
        <h1>Recipe books</h1>
        <p>Printed, bound and tested in our own kitchen.</p>
        <div class="breadcrumb-chip">
            <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Home</a>
            <i class="fas fa-chevron-right" style="font-size:.6rem;opacity:.7"></i>
            <span>Books</span>
        </div>
    </div>
</section>

<!-- ===== TRUST STRIP ===== -->
<section class="py-4" style="background:#fff;border-bottom:1px solid var(--line)">
    <div class="container">
        <div class="row g-3 text-center">
            <div class="col-6 col-md-3"><span class="small fw-semibold"><i class="fas fa-book-open text-primary me-2"></i>@books.Count titles</span></div>
            <div class="col-6 col-md-3"><span class="small fw-semibold"><i class="fas fa-truck-fast text-primary me-2"></i>Free shipping over $100</span></div>
            <div class="col-6 col-md-3"><span class="small fw-semibold"><i class="fas fa-crown text-warning me-2"></i>10% off for members</span></div>
            <div class="col-6 col-md-3"><span class="small fw-semibold"><i class="fas fa-rotate-left text-primary me-2"></i>14-day returns</span></div>
        </div>
    </div>
</section>

<!-- ===== BOOKS ===== -->
<section class="py-5" style="padding-top:4rem !important;padding-bottom:4.5rem !important;">
    <div class="container">
        @if (books.Count == 0)
        {
            <div class="text-center py-5 surface-card p-5" data-aos="fade-up">
                <i class="fas fa-book-open fa-3x mb-3" style="color:var(--rose)"></i>
                <h4 class="fw-bold">No books in stock</h4>
                <p class="text-muted mb-4">New print runs are added regularly. Browse our flavours in the meantime.</p>
                <a asp-controller="Home" asp-action="Product" class="btn btn-primary">Browse flavours</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var book in books)
                {
                    <div class="col-lg-4 col-md-6" data-aos="fade-up">
                        <div class="product-card h-100 d-flex flex-column">
                            <div class="product-image position-relative" style="aspect-ratio:4/3;">
                                <span class="product-badge" style="background:@(book.StockQuantity > 0 ? "rgba(6,118,71,.9)" : "rgba(180,35,24,.9)")">
                                    @(book.StockQuantity > 0 ? "In stock" : "Out of stock")
                                </span>
                                @if (!string.IsNullOrEmpty(book.ImagePath))
                                {
                                    <img src="@Url.Content(book.ImagePath)" alt="@book.Title" class="img-cover" loading="lazy" />
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center h-100" style="font-size:4rem;color:var(--rose);opacity:.35">
                                        <i class="fas fa-book"></i>
                                    </div>
                                }
                            </div>
                            <div class="product-body d-flex flex-column flex-grow-1">
                                <h5 class="product-title">@book.Title</h5>
                                <p class="small text-muted mb-2"><i class="fas fa-pen-nib me-1"></i>@book.Author</p>
                                <p class="small text-muted mb-3">@book.Description</p>
                                <div class="d-flex align-items-center justify-content-between pt-3 mt-auto" style="border-top:1px solid var(--line)">
                                    <span class="current-price" style="font-size:1.35rem;font-weight:800;color:var(--rose-ink)">$@book.Price.ToString("0.00")</span>
                                    @if (book.StockQuantity > 0)
                                    {
                                        <a asp-controller="Book" asp-action="Order" asp-route-id="@book.Id" class="btn btn-primary btn-sm">
                                            <i class="fas fa-shopping-bag me-1"></i>Order now
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="btn btn-sm disabled" style="background:#F2F4F7;color:#98A2B3;border:0">Sold out</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

<!-- ===== WHY BUY ===== -->
<section class="py-5 bg-blush">
    <div class="container">
        <div class="section-title" data-aos="fade-up">
            <span class="eyebrow justify-content-center">Why our books</span>
            <h2 class="mt-2">Written by the people who churn</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4" data-aos="fade-up">
                <div class="surface-card h-100 p-4 text-center hover-lift">
                    <div class="stat-icon mx-auto mb-3"><i class="fas fa-flask"></i></div>
                    <h5 class="fw-bold">Tested recipes</h5>
                    <p class="small text-muted mb-0">Every recipe is scaled for a home churn and tested at least three times.</p>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="80">
                <div class="surface-card h-100 p-4 text-center hover-lift">
                    <div class="stat-icon blue mx-auto mb-3"><i class="fas fa-percent"></i></div>
                    <h5 class="fw-bold">Member pricing</h5>
                    <p class="small text-muted mb-0">Club members save 10% on every title, every day.</p>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="160">
                <div class="surface-card h-100 p-4 text-center hover-lift">
                    <div class="stat-icon green mx-auto mb-3"><i class="fas fa-box"></i></div>
                    <h5 class="fw-bold">Careful packing</h5>
                    <p class="small text-muted mb-0">Rigid mailers and recycled packaging so your book arrives flat.</p>
                </div>
            </div>
        </div>
    </div>
</section>
