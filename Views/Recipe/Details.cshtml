@model Ice_Cream_Parlour_Eproject.Models.Recipe
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.Name + " - iCREAM";
}

<!-- ===== PAGE HEADER ===== -->
<div style="background: linear-gradient(135deg, rgba(241,149,178,0.9), rgba(98,195,231,0.9)), url('/img/header.jpg'); background-size: cover; background-position: center; min-height: 200px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; color: white; border-radius: 0 0 30px 30px; padding: 40px 20px;">
    <h1 style="font-size: 2.5rem; font-weight: 700; font-family: 'Playfair Display', serif; text-shadow: 0 2px 15px rgba(0,0,0,0.2);">
        @Model.Name
    </h1>
    <p style="font-size: 1.1rem; opacity: 0.95;"><i class="fas fa-tag me-1"></i> Category: @Model.Category</p>
</div>

<!-- ===== DETAILS CONTENT ===== -->
<div class="container py-5">
    <div class="row g-4 align-items-center">
        <div class="col-md-5">
            <div class="rounded-4 overflow-hidden shadow-sm border">
                @{
                    var imagePath = !string.IsNullOrEmpty(Model.ImagePath) ? Model.ImagePath : "/img/product-1.jpg";
                }
                <img src="@imagePath" alt="@Model.Name" class="img-fluid w-100" style="max-height: 400px; object-fit: cover;" />
            </div>
        </div>
        <div class="col-md-7">
            <div class="bg-white p-4 rounded-4 shadow-sm border">
                <span class="badge mb-3 px-3 py-2" style="background: @(Model.IsFree ? "#28a745" : "#F195B2"); font-size: 0.85rem;">
                    @(Model.IsFree ? "Free Recipe" : "Premium Recipe")
                </span>
                <h2 class="fw-bold mb-3" style="font-family: 'Playfair Display', serif;">@Model.Name</h2>

                <h5 class="fw-bold mt-4 text-primary"><i class="fas fa-list-ul me-2"></i>Ingredients</h5>
                <p class="text-muted fs-6">@Model.Ingredients</p>

                <h5 class="fw-bold mt-4 text-primary"><i class="fas fa-tasks me-2"></i>Procedure</h5>
                <p class="text-muted fs-6" style="white-space: pre-line;">@Model.Procedure</p>

                <div class="mt-4">
                    <a asp-action="Index" class="btn btn-secondary rounded-pill px-4 me-2">
                        <i class="fas fa-arrow-left me-2"></i>Back to Recipes
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
