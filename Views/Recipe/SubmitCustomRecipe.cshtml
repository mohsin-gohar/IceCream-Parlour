@model Ice_Cream_Parlour_Eproject.Models.UserRecipe
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Submit Custom Recipe - iCREAM";
}

<!-- ===== PAGE HEADER ===== -->
<div style="background: linear-gradient(135deg, rgba(241,149,178,0.9), rgba(98,195,231,0.9)), url('/img/header.jpg'); background-size: cover; background-position: center; min-height: 200px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; color: white; border-radius: 0 0 30px 30px; padding: 40px 20px;">
    <h1 style="font-size: 2.5rem; font-weight: 700; font-family: 'Playfair Display', serif; text-shadow: 0 2px 15px rgba(0,0,0,0.2);">
        <i class="fas fa-plus-circle me-2"></i> Submit Your Custom Recipe
    </h1>
    <p style="font-size: 1.1rem; opacity: 0.95; max-width: 550px;">Share your unique ice cream creation! Top recipes win cash prizes and certificates.</p>
</div>

<!-- ===== SUBMISSION FORM ===== -->
<div class="container py-5" style="max-width: 800px;">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
        <h4 class="fw-bold mb-4" style="font-family: 'Playfair Display', serif; color: #2d2d2d;">
            <i class="fas fa-utensils text-primary me-2"></i>Recipe Details
        </h4>

        <form asp-controller="Recipe" asp-action="SubmitCustomRecipe" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label fw-semibold">Recipe Name <span class="text-danger">*</span></label>
                <input asp-for="RecipeName" class="form-control form-control-lg rounded-3" placeholder="e.g. Mango Coconut Crunch" required />
                <span asp-validation-for="RecipeName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Ingredients <span class="text-danger">*</span></label>
                <textarea asp-for="Ingredients" class="form-control rounded-3" rows="4" placeholder="List all ingredients (e.g. 2 cups heavy cream, 1 cup mango puree, 1/2 cup sugar...)" required></textarea>
                <span asp-validation-for="Ingredients" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Procedure / Preparation Steps <span class="text-danger">*</span></label>
                <textarea asp-for="Procedure" class="form-control rounded-3" rows="5" placeholder="Step-by-step instructions to prepare your ice cream..." required></textarea>
                <span asp-validation-for="Procedure" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Photo of Your Creation</label>
                <input type="file" name="ImageFile" accept="image/*" class="form-control form-control-lg rounded-3" />
                <small class="text-muted">Optional: Upload a clear image of your finished ice cream (JPG, PNG, WebP)</small>
            </div>

            <div class="d-flex gap-3">
                <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold" style="background: linear-gradient(135deg, #F195B2, #62C3E7); border: none;">
                    <i class="fas fa-paper-plane me-2"></i>Submit Recipe
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>
