@model IEnumerable<Ice_Cream_Parlour_Eproject.Models.Recipe>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Recipes - iCREAM";
}

<style>
    .recipe-card {
        background: #fff;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,0.06);
        border: 1px solid rgba(241,149,178,0.06);
        transition: all 0.3s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .recipe-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 35px rgba(241,149,178,0.15);
        border-color: #F195B2;
    }

    .recipe-card img {
        transition: transform 0.5s ease;
    }

    .recipe-card:hover img {
        transform: scale(1.05);
    }

    .recipe-card .card-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        padding: 18px;
    }
</style>

<!-- ===== PAGE HEADER ===== -->
<div style="background: linear-gradient(135deg, rgba(241,149,178,0.9), rgba(98,195,231,0.9)), url('/img/header.jpg'); background-size: cover; background-position: center; min-height: 220px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; color: white; border-radius: 0 0 30px 30px; padding: 40px 20px;">
    <h1 style="font-size: 2.5rem; font-weight: 700; font-family: 'Playfair Display', serif; text-shadow: 0 2px 15px rgba(0,0,0,0.2);">
        <i class="fas fa-utensils me-3"></i> Ice Cream Recipes
    </h1>
    <p style="font-size: 1.1rem; opacity: 0.95; max-width: 500px;">Explore our collection of delicious ice cream recipes</p>
</div>

<!-- ===== RECIPE GRID ===== -->
<div style="max-width: 1200px; margin: 40px auto; padding: 0 20px;">
    @if (Model == null || !Model.Any())
    {
        <div style="text-align: center; padding: 60px 0;">
            <i class="fas fa-utensils fa-3x text-muted mb-3"></i>
            <h4 style="color: #888;">No recipes found</h4>
        </div>
    }
    else
    {
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 25px;">
            @foreach (var r in Model)
            {
                var imgSrc = !string.IsNullOrEmpty(r.ImagePath) ? r.ImagePath : "/img/product-1.jpg";
                <div class="recipe-card">
                    <div style="overflow: hidden; position: relative; padding-top: 80%; background: #f8f5f6;">
                        <img src="@imgSrc" alt="@r.Name" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;" loading="lazy" />
                        <span style="position: absolute; top: 12px; left: 12px; background: @(r.IsFree ? "linear-gradient(135deg, #28a745, #20c997)" : "linear-gradient(135deg, #F195B2, #62C3E7)"); color: #fff; padding: 4px 14px; border-radius: 50px; font-size: 11px; font-weight: 700; text-transform: uppercase;">
                            @(r.IsFree ? "Free Access" : "Premium")
                        </span>
                    </div>
                    <div class="card-body">
                        <h5 style="font-size: 1.15rem; font-weight: 700; color: #2d2d2d; margin-bottom: 6px; font-family: 'Playfair Display', serif;">@r.Name</h5>
                        <div style="font-size: 0.8rem; color: #F195B2; font-weight: 600; margin-bottom: 8px;">
                            <i class="fas fa-tag me-1"></i> @r.Category
                        </div>
                        <p style="font-size: 0.85rem; color: #666; line-height: 1.5; margin-bottom: 12px; flex: 1;">
                            <strong>Ingredients:</strong> @(r.Ingredients.Length > 80 ? r.Ingredients.Substring(0, 80) + "..." : r.Ingredients)
                        </p>
                        <a asp-controller="Recipe" asp-action="Details" asp-route-id="@r.Id" class="btn btn-outline-primary rounded-pill w-100" style="border-color: #F195B2; color: #F195B2; font-weight: 600;">
                            View Details <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>
