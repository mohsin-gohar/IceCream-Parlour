@model IEnumerable<Ice_Cream_Parlour_Eproject.Models.Recipe>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Recipes";
    var recipes = Model?.ToList() ?? new List<Ice_Cream_Parlour_Eproject.Models.Recipe>();
    var categories = recipes.Select(r => r.Category).Where(c => !string.IsNullOrWhiteSpace(c)).Distinct().OrderBy(c => c).ToList();
    var freeCount = recipes.Count(r => r.IsFree);
}

<!-- ===== PAGE HEADER ===== -->
<section class="page-header-premium">
    <div class="container">
        <h1>The recipe archive</h1>
        <p>@recipes.Count recipes · @freeCount free to try · new drops every month.</p>
        <div class="breadcrumb-chip">
            <a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Home</a>
            <i class="fas fa-chevron-right" style="font-size:.6rem;opacity:.7"></i>
            <span>Recipes</span>
        </div>
    </div>
</section>

<section class="py-5" style="padding-top:4rem !important;padding-bottom:4.5rem !important;">
    <div class="container">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4" data-aos="fade-up">
            <div>
                <span class="eyebrow">Browse</span>
                <h2 class="mt-2 mb-0" style="font-size:1.75rem">Find your next favourite</h2>
            </div>
            <a asp-controller="Recipe" asp-action="SubmitCustomRecipe" class="btn btn-primary">
                <i class="fas fa-plus-circle me-2"></i>Submit your recipe
            </a>
        </div>

        @if (categories.Count > 1)
        {
            <div class="d-flex flex-wrap gap-2 mb-4" id="recipeFilters">
                <button type="button" class="filter-chip active" data-filter="all">All</button>
                @foreach (var category in categories)
                {
                    <button type="button" class="filter-chip" data-filter="@category">@category</button>
                }
            </div>
        }

        @if (recipes.Count == 0)
        {
            <div class="text-center py-5 surface-card p-5" data-aos="fade-up">
                <i class="fas fa-utensils fa-3x mb-3" style="color:var(--rose)"></i>
                <h4 class="fw-bold">No recipes yet</h4>
                <p class="text-muted mb-4">Be the first to share a recipe with the community.</p>
                <a asp-controller="Recipe" asp-action="SubmitCustomRecipe" class="btn btn-primary">Submit a recipe</a>
            </div>
        }
        else
        {
            <div class="row g-4" id="recipeGrid">
                @foreach (var r in recipes)
                {
                    var imgSrc = string.IsNullOrEmpty(r.ImagePath) ? Url.Content("~/img/product-1.jpg") : Url.Content(r.ImagePath);
                    var snippet = r.Ingredients.Length > 90 ? r.Ingredients.Substring(0, 90) + "…" : r.Ingredients;
                    <div class="col-lg-4 col-md-6 recipe-cell" data-category="@r.Category" data-aos="fade-up">
                        <div class="recipe-card h-100 d-flex flex-column">
                            <div class="position-relative overflow-hidden" style="aspect-ratio:4/3;">
                                <span class="product-badge" style="background:@(r.IsFree ? "rgba(6,118,71,.9)" : "rgba(16,24,40,.75)")">
                                    @(r.IsFree ? "Free" : "Premium")
                                </span>
                                <img src="@imgSrc" alt="@r.Name" class="img-cover" loading="lazy" />
                            </div>
                            <div class="p-4 d-flex flex-column flex-grow-1">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="badge" style="background:rgba(241,149,178,.14);color:var(--rose-ink);font-size:.7rem">@r.Category</span>
                                    @if (r.Price > 0)
                                    {
                                        <span class="small fw-bold" style="color:var(--rose-ink)">$@r.Price.ToString("0.00")</span>
                                    }
                                </div>
                                <h5 class="fw-bold mb-2" style="font-family:'Playfair Display',serif">@r.Name</h5>
                                <p class="small text-muted mb-3">@snippet</p>
                                <a asp-controller="Recipe" asp-action="Details" asp-route-id="@r.Id" class="btn btn-outline-primary btn-sm mt-auto align-self-start">
                                    Read recipe <i class="fas fa-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

<section class="py-5 bg-cream">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center" data-aos="fade-up">
                <span class="eyebrow justify-content-center">Community</span>
                <h2 class="mt-2 mb-3">Got a recipe worth sharing?</h2>
                <p class="text-muted mb-4">Submit your creation for review. Selected recipes are published in the archive, and the best of the month wins a prize.</p>
                <a asp-controller="Recipe" asp-action="SubmitCustomRecipe" class="btn btn-primary btn-lg">Submit your recipe</a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var chips = document.querySelectorAll('#recipeFilters .filter-chip');
            var cells = document.querySelectorAll('#recipeGrid .recipe-cell');
            if (!chips.length || !cells.length) return;

            chips.forEach(function (chip) {
                chip.addEventListener('click', function () {
                    chips.forEach(function (c) { c.classList.remove('active'); });
                    chip.classList.add('active');
                    var filter = chip.getAttribute('data-filter');
                    cells.forEach(function (cell) {
                        var match = filter === 'all' || cell.getAttribute('data-category') === filter;
                        cell.style.display = match ? '' : 'none';
                    });
                });
            });
        });
    </script>
}
