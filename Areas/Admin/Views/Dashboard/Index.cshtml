@using Ice_Cream_Parlour_Eproject.Areas.Models.ViewModels
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header" data-aos="fade-up">
    <div>
        <span class="eyebrow">Overview</span>
        <h2 class="mt-1">Good @(DateTime.Now.Hour < 12 ? "morning" : DateTime.Now.Hour < 18 ? "afternoon" : "evening")</h2>
        <p>@DateTime.Now.ToString("dddd, dd MMMM yyyy") · here is how the parlour is doing.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-area="Admin" asp-controller="Orders" asp-action="Create" class="btn btn-primary-custom">
            <i class="fas fa-plus me-2"></i>New order
        </a>
        <a asp-area="Admin" asp-controller="Reports" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-chart-line me-2"></i>Reports
        </a>
    </div>
</div>

<!-- ===== PRIMARY KPIs ===== -->
<div class="stats-grid">
    <div class="stat-card" data-aos="fade-up">
        <div class="stat-icon green"><i class="fas fa-dollar-sign"></i></div>
        <div class="stat-info">
            <h3>$@Model.TodaySales.ToString("N2")</h3>
            <p>Revenue today</p>
        </div>
    </div>
    <div class="stat-card" data-aos="fade-up" data-aos-delay="60">
        <div class="stat-icon"><i class="fas fa-receipt"></i></div>
        <div class="stat-info">
            <h3>@Model.TotalOrders</h3>
            <p>Total orders</p>
        </div>
    </div>
    <div class="stat-card" data-aos="fade-up" data-aos-delay="120">
        <div class="stat-icon blue"><i class="fas fa-users"></i></div>
        <div class="stat-info">
            <h3>@Model.TotalCustomers</h3>
            <p>Customers</p>
        </div>
    </div>
    <div class="stat-card" data-aos="fade-up" data-aos-delay="180">
        <div class="stat-icon orange"><i class="fas fa-ice-cream"></i></div>
        <div class="stat-info">
            <h3>@Model.TotalProducts</h3>
            <p>Products live</p>
        </div>
    </div>
</div>

<!-- ===== SECONDARY KPIs ===== -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="surface-card p-3 h-100">
            <div class="small text-muted">This month</div>
            <div class="fw-bold fs-5">$@Model.MonthlySales.ToString("N0")</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="surface-card p-3 h-100">
            <div class="small text-muted">This year</div>
            <div class="fw-bold fs-5">$@Model.YearlySales.ToString("N0")</div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="surface-card p-3 h-100 d-flex justify-content-between align-items-center">
            <div>
                <div class="small text-muted">Pending orders</div>
                <div class="fw-bold fs-5">@Model.PendingOrders</div>
            </div>
            <a asp-area="Admin" asp-controller="Orders" asp-action="Index" asp-route-status="Pending" class="btn-action view"><i class="fas fa-arrow-right"></i></a>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="surface-card p-3 h-100 d-flex justify-content-between align-items-center">
            <div>
                <div class="small text-muted">Categories</div>
                <div class="fw-bold fs-5">@Model.TotalCategories</div>
            </div>
            <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="btn-action view"><i class="fas fa-arrow-right"></i></a>
        </div>
    </div>
</div>

<!-- ===== CHART + STATUS ===== -->
<div class="row g-4 mb-2">
    <div class="col-lg-8">
        <div class="chart-card h-100" data-aos="fade-up">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="mb-0">Revenue · last 7 days</h5>
                    <small class="text-muted">Paid and pending orders</small>
                </div>
                <span class="badge-status badge-completed"><i class="fas fa-circle"></i> Live</span>
            </div>
            <div class="chart-container" style="height:320px">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="chart-card h-100" data-aos="fade-up" data-aos-delay="80">
            <h5 class="mb-3">Order pipeline</h5>
            <div class="chart-container" style="height:200px">
                <canvas id="statusChart"></canvas>
            </div>
            <ul class="list-unstyled mt-3 mb-0 small">
                <li class="d-flex justify-content-between py-1"><span class="text-muted"><span class="badge-status badge-pending me-2">Pending</span></span><strong>@Model.PendingOrders</strong></li>
                <li class="d-flex justify-content-between py-1"><span class="text-muted"><span class="badge-status badge-processing me-2">Processing</span></span><strong>@Model.ProcessingOrders</strong></li>
                <li class="d-flex justify-content-between py-1"><span class="text-muted"><span class="badge-status badge-shipped me-2">Shipped</span></span><strong>@Model.ShippedOrders</strong></li>
                <li class="d-flex justify-content-between py-1"><span class="text-muted"><span class="badge-status badge-completed me-2">Completed</span></span><strong>@Model.CompletedOrders</strong></li>
            </ul>
        </div>
    </div>
</div>

<!-- ===== LOW STOCK + TOP SELLERS ===== -->
<div class="row g-4 mb-4">
    <div class="col-lg-5">
        <div class="table-card h-100" data-aos="fade-up">
            <div class="table-header">
                <h5><i class="fas fa-triangle-exclamation text-warning me-2"></i>Low stock</h5>
                <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="small fw-semibold text-decoration-none">Manage</a>
            </div>
            <div class="p-3">
                @if (Model.LowStockProducts.Any())
                {
                    foreach (var item in Model.LowStockProducts)
                    {
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="small fw-semibold">@item.Name</span>
                                    <span class="small text-muted">@item.StockQuantity left</span>
                                </div>
                                <div class="progress" style="height:6px;border-radius:99px;background:#F2F4F7">
                                    <div class="progress-bar" style="width:@(item.StockPercent)%;background:@(item.StockPercent <= 30 ? "linear-gradient(90deg,#F04438,#FDA29B)" : "linear-gradient(90deg,#FDB022,#FEC84B)");border-radius:99px"></div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="fas fa-check-circle fa-2x text-success mb-2"></i>
                        <p class="small text-muted mb-0">Everything is comfortably in stock.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="table-card h-100" data-aos="fade-up" data-aos-delay="80">
            <div class="table-header">
                <h5><i class="fas fa-crown text-warning me-2"></i>Top sellers</h5>
                <span class="small text-muted">By units sold</span>
            </div>
            <div class="p-3">
                @if (Model.TopSellingProducts.Any())
                {
                    foreach (var product in Model.TopSellingProducts)
                    {
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="stat-icon" style="width:38px;height:38px;font-size:.8rem"><i class="fas fa-ice-cream"></i></div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="small fw-semibold">@product.ProductName</span>
                                    <span class="small text-muted">@product.TotalSold sold</span>
                                </div>
                                <div class="progress" style="height:6px;border-radius:99px;background:#F2F4F7">
                                    <div class="progress-bar" style="width:@(product.ProgressPercent)%;background:var(--grad-rose);border-radius:99px"></div>
                                </div>
                            </div>
                            <span class="small fw-bold" style="color:var(--rose-ink);min-width:70px;text-align:right">$@product.Revenue.ToString("N0")</span>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="fas fa-chart-simple fa-2x text-muted mb-2"></i>
                        <p class="small text-muted mb-0">No product sales recorded yet.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ===== RECENT ORDERS ===== -->
<div class="table-card" data-aos="fade-up">
    <div class="table-header">
        <h5><i class="fas fa-clock-rotate-left text-primary me-2"></i>Recent orders</h5>
        <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="small fw-semibold text-decoration-none">View all orders</a>
    </div>
    @if (Model.RecentOrders.Any())
    {
        <div class="table-responsive">
            <table class="table table-premium mb-0">
                <thead>
                    <tr><th>Order</th><th>Customer</th><th>Date</th><th>Total</th><th>Status</th><th>Payment</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.RecentOrders)
                    {
                        <tr>
                            <td class="fw-semibold">@order.OrderNumber</td>
                            <td>@order.CustomerName</td>
                            <td class="text-muted">@order.OrderDate.ToString("dd MMM, HH:mm")</td>
                            <td class="fw-semibold">$@order.TotalAmount.ToString("N2")</td>
                            <td><span class="badge-status badge-@order.OrderStatus.ToLower()">@order.OrderStatus</span></td>
                            <td><span class="badge-status badge-@order.PaymentStatus.ToLower()">@order.PaymentStatus</span></td>
                            <td class="text-end">
                                <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="btn-action view" title="View order"><i class="fas fa-eye"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-receipt fa-3x text-muted mb-3"></i>
            <h6 class="fw-bold">No orders yet</h6>
            <p class="small text-muted mb-3">Orders will appear here as soon as customers check out.</p>
            <a asp-area="Admin" asp-controller="Orders" asp-action="Create" class="btn btn-primary-custom btn-sm">Create the first order</a>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            if (typeof Chart === 'undefined') return;

            Chart.defaults.font.family = "'Inter', sans-serif";
            Chart.defaults.color = '#667085';

            var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueChartLabels));
            var data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueChartData));

            var canvas = document.getElementById('revenueChart');
            if (canvas) {
                var ctx = canvas.getContext('2d');
                var gradient = ctx.createLinearGradient(0, 0, 0, 320);
                gradient.addColorStop(0, 'rgba(241,149,178,.35)');
                gradient.addColorStop(1, 'rgba(241,149,178,0)');

                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Revenue',
                            data: data,
                            borderColor: '#E07A9E',
                            backgroundColor: gradient,
                            borderWidth: 3,
                            fill: true,
                            tension: 0.4,
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            pointBackgroundColor: '#fff',
                            pointBorderColor: '#E07A9E',
                            pointBorderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: { color: 'rgba(16,24,40,.06)' },
                                ticks: { callback: function (v) { return '$' + v; } }
                            },
                            x: { grid: { display: false } }
                        }
                    }
                });
            }

            var statusCanvas = document.getElementById('statusChart');
            if (statusCanvas) {
                new Chart(statusCanvas, {
                    type: 'doughnut',
                    data: {
                        labels: ['Pending', 'Processing', 'Shipped', 'Completed'],
                        datasets: [{
                            data: [@Model.PendingOrders, @Model.ProcessingOrders, @Model.ShippedOrders, @Model.CompletedOrders],
                            backgroundColor: ['#FDB022', '#62C3E7', '#7A5AF8', '#12B76A'],
                            borderWidth: 0,
                            hoverOffset: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '68%',
                        plugins: { legend: { display: false } }
                    }
                });
            }
        })();
    </script>
}
