@model Ice_Cream_Parlour_Eproject.Models.UserRecipe
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Recipe Review - Admin";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill mb-3">
        <i class="fas fa-arrow-left me-1"></i>Back to List
    </a>
    <h2 class="fw-bold m-0"><i class="fas fa-search me-2 text-primary"></i>Review Custom Recipe</h2>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <img src="@Model.ImagePath" alt="@Model.RecipeName" class="img-fluid rounded-3 mb-3" style="max-height: 300px; object-fit: cover;" />
            }
            <h3 class="fw-bold text-primary mb-2">@Model.RecipeName</h3>
            <p class="text-muted small mb-3">Submitted by <strong>@Model.UserName</strong> on @Model.SubmittedDate.ToString("F")</p>

            <h5 class="fw-bold mt-3"><i class="fas fa-list-ul me-2 text-primary"></i>Ingredients</h5>
            <p style="white-space: pre-line;">@Model.Ingredients</p>

            <h5 class="fw-bold mt-4"><i class="fas fa-tasks me-2 text-primary"></i>Procedure</h5>
            <p style="white-space: pre-line;">@Model.Procedure</p>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h4 class="fw-bold mb-3"><i class="fas fa-cogs me-2 text-primary"></i>Admin Decision</h4>

            <form asp-action="Review" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">Status</label>
                    <select name="status" class="form-select rounded-3">
                        <option value="Pending" selected="@(Model.Status == "Pending")">Pending</option>
                        <option value="Selected" selected="@(Model.Status == "Selected")">Selected (Show in Gallery)</option>
                        <option value="Approved" selected="@(Model.Status == "Approved")">Approved</option>
                        <option value="Rejected" selected="@(Model.Status == "Rejected")">Rejected</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Prize Money ($)</label>
                    <input type="number" step="0.01" name="prizeMoney" class="form-control rounded-3" value="@(Model.PrizeMoney.HasValue ? Model.PrizeMoney.Value.ToString("0.00") : "0.00")" />
                </div>

                <div class="mb-3 form-check">
                    <input type="checkbox" name="isCertificateIssued" value="true" class="form-check-input" id="certCheck" checked="@Model.IsCertificateIssued" />
                    <label class="form-check-label fw-semibold" for="certCheck">Certificate Issued?</label>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Admin Remarks</label>
                    <textarea name="adminRemarks" class="form-control rounded-3" rows="3" placeholder="Remarks for the user...">@Model.AdminRemarks</textarea>
                </div>

                <button type="submit" class="btn btn-primary btn-lg rounded-pill w-100 fw-bold">
                    <i class="fas fa-save me-2"></i>Save Decision
                </button>
            </form>
        </div>
    </div>
</div>
