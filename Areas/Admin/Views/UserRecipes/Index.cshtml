@model IEnumerable<Ice_Cream_Parlour_Eproject.Models.UserRecipe>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "User Submitted Recipes - Admin";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold m-0"><i class="fas fa-user-edit text-primary me-2"></i>User Custom Recipes</h2>
        <p class="text-muted mb-0">Review, approve, and manage customer submitted ice cream recipes</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-file-alt fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">No custom recipes submitted yet</h5>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Submitted By</th>
                            <th>Recipe Name</th>
                            <th>Submitted Date</th>
                            <th>Status</th>
                            <th>Prize Awarded</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold">@r.UserName</div>
                                </td>
                                <td>@r.RecipeName</td>
                                <td>@r.SubmittedDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @switch (r.Status)
                                    {
                                        case "Selected":
                                        case "Approved":
                                            <span class="badge bg-success">@r.Status</span>
                                            break;
                                        case "Rejected":
                                            <span class="badge bg-danger">@r.Status</span>
                                            break;
                                        default:
                                            <span class="badge bg-warning text-dark">Pending</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @(r.PrizeMoney.HasValue && r.PrizeMoney > 0 ? $"${r.PrizeMoney.Value:0.00}" : "-")
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-primary rounded-pill px-3 me-1">
                                        <i class="fas fa-eye me-1"></i>Review
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
